normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

# Schemas that hold user data (filters pg_namespace; no system, toast or temp schemas)
USER_SCHEMAS="nspname !~ '^pg_' and nspname <> 'information_schema'"

user_databases() {
  psql_q "select datname from pg_database where datallowconn and not datistemplate and datname <> 'postgres' order by 1"
}

list_roles() {
  psql_q "select rolname from pg_roles where rolname !~ '^pg_' order by 1"
}

apps_using() {
  local col=$1 value=$2
  scan_apps | awk -F'\t' -v c="$col" -v v="$value" '$c == v {print $1}' | xargs -r -n1 basename | paste -sd',' - | sed 's/,/, /g'
}

ask_new_name() {
  local __nn_var=$1 __nn_prompt=$2 __nn_kind=$3 __nn_def=${4-} __nn_reply
  while :; do
    ask __nn_reply "$__nn_prompt" "$__nn_def"
    if ! valid_name "$__nn_reply"; then
      warn "Use lowercase letters, digits and _ (starting with a letter or _)"
    elif [[ $__nn_kind == db && -n $(psql_q "select 1 from pg_database where datname = $(sql_lit "$__nn_reply")") ]]; then
      warn "Database $__nn_reply already exists"
    elif [[ $__nn_kind == user ]] && role_exists "$__nn_reply"; then
      warn "User $__nn_reply already exists"
    else
      break
    fi
  done
  printf -v "$__nn_var" '%s' "$__nn_reply"
}

pick_role() {
  local __pr_roles=() __pr_r __pr_list=()
  mapfile -t __pr_roles < <(list_roles)
  for __pr_r in "${__pr_roles[@]}"; do
    if [[ -n $__pr_r && ! ($__pr_r == postgres && ${3-} == nopostgres) ]]; then __pr_list+=("$__pr_r"); fi
  done
  pick_item "$1" "$2" "${__pr_list[@]}"
}

DBS=""
parse_databases() {
  local list=${1//,/ } db
  DBS=""
  for db in $list; do
    if [[ $db != all ]]; then
      database_exists "$db" || die "Database $db does not exist"
    fi
    if [[ " $DBS " != *" $db "* ]]; then DBS+="${DBS:+ }$db"; fi
  done
  [[ -n $DBS ]] || die "No databases given"
}

ask_databases() {
  local __adb_var=$1 __adb_reply __adb_db __adb_bad
  info "Databases: $(user_databases | paste -sd' ' -)"
  while :; do
    ask __adb_reply "$2 (comma-separated, 'all' = every database)" "${3-}"
    __adb_bad=""
    for __adb_db in ${__adb_reply//,/ }; do
      if [[ $__adb_db != all ]] && ! database_exists "$__adb_db"; then __adb_bad+=" $__adb_db"; fi
    done
    if [[ -z ${__adb_reply//[, ]/} ]]; then
      warn "Enter at least one database"
    elif [[ -n $__adb_bad ]]; then
      warn "Unknown database:$__adb_bad"
    else
      break
    fi
  done
  printf -v "$__adb_var" '%s' "$__adb_reply"
}

PW_SHOW=0
ask_password() {
  local __pw_pick="" __pw_a="" __pw_b=""
  choose __pw_pick "Password" 1 "Generate a random one (shown once)" "Enter one"
  if [[ $__pw_pick == 1 ]]; then
    PW_SHOW=1
    printf -v "$1" '%s' "$(random_secret 32)"
    return 0
  fi
  while :; do
    ask_secret __pw_a "New password"
    ask_secret __pw_b "Repeat it"
    if [[ $__pw_a != "$__pw_b" ]]; then
      warn "The passwords differ"
    elif ((${#__pw_a} < 12)); then
      warn "Use at least 12 characters"
    else
      break
    fi
  done
  printf -v "$1" '%s' "$__pw_a"
}

get_password() {
  local __gp_pw=""
  PW_SHOW=0
  if [[ -n $2 ]]; then
    IFS= read -r __gp_pw || true
    [[ -n $__gp_pw ]] || die "No password on stdin"
  elif (($3)); then
    ask_password __gp_pw
  else
    __gp_pw=$(random_secret 32)
    PW_SHOW=1
  fi
  printf -v "$1" '%s' "$__gp_pw"
}

show_credentials() {
  local user=$1 pass=$2 db=$3 listen
  if (($4 == 0)); then pass="<your password>"; fi
  listen=$(pg_setting listen_addresses)
  printf '\n  %sConnection — store the password now, it is not saved anywhere:%s\n' "$Y" "$N"
  printf '    DB_CONNECTION=pgsql\n    DB_HOST=127.0.0.1\n    DB_PORT=%s\n    DB_DATABASE=%s\n    DB_USERNAME=%s\n    DB_PASSWORD=%s\n' \
    "$PG_PORT" "$db" "$user" "$pass"
  printf '    %spostgresql://%s:%s@127.0.0.1:%s/%s%s\n' "$D" "$user" "$pass" "$PG_PORT" "$db" "$N"
  if [[ -z $listen || $listen == localhost || $listen == 127.0.0.1 ]]; then
    info "PostgreSQL listens on localhost only — connect external tools through an SSH tunnel."
  fi
}

role_database() {
  psql_q "select coalesce(
      (select datname from pg_database where datdba = r.oid and not datistemplate and datname <> 'postgres' order by 1 limit 1),
      (select d.datname from pg_database d, aclexplode(d.datacl) a
        where a.grantee = r.oid and a.privilege_type = 'CONNECT' order by 1 limit 1),
      'postgres')
    from pg_roles r where rolname = $(sql_lit "$1")"
}

create_role() {
  psql_secret "create role $(sql_ident "$1") with login password $(sql_lit "$2")"
}

set_password() {
  psql_secret "alter role $(sql_ident "$1") with password $(sql_lit "$2")"
}

create_database() {
  local opts="" enc
  enc=$(psql_q "select pg_encoding_to_char(encoding) from pg_database where datname = 'template1'")
  if [[ $enc != UTF8 ]]; then
    info "template1 uses $enc — creating $1 as UTF8 (C.UTF-8) from template0"
    opts=" template template0 encoding 'UTF8' lc_collate 'C.UTF-8' lc_ctype 'C.UTF-8'"
  fi
  psql_q "create database $(sql_ident "$1") owner $(sql_ident "$2")$opts" >/dev/null
}

make_read_only() {
  psql_q "alter role $(sql_ident "$1") set default_transaction_read_only = on" >/dev/null
  if ((${PG_VERSION%%.*} < 15)); then
    warn "PostgreSQL $PG_VERSION lets every user CREATE in schema public, read-only users included."
    info "Per database, as its owner: REVOKE CREATE ON SCHEMA public FROM PUBLIC; GRANT CREATE ON SCHEMA public TO <app user>;"
  fi
}

grant_read_only() {
  local role=$1 db=$2 r l
  r=$(sql_ident "$role") l=$(sql_lit "$role")
  if [[ $db == all ]]; then
    ((${PG_VERSION%%.*} >= 14)) || die "'all' needs PostgreSQL 14+ (pg_read_all_data) — list the databases instead"
    psql_q "grant pg_read_all_data to $r" >/dev/null
    ok "$role can read every database (pg_read_all_data)"
    return 0
  fi
  psql_script "$db" >/dev/null <<SQL
grant connect on database $(sql_ident "$db") to $r;
select format('grant usage on schema %I to %I', nspname, $l),
       format('grant select on all tables in schema %I to %I', nspname, $l),
       format('grant select on all sequences in schema %I to %I', nspname, $l)
  from pg_namespace where $USER_SCHEMAS \gexec
select format('alter default privileges for role %I grant select on tables to %I', rolname, $l),
       format('alter default privileges for role %I grant select on sequences to %I', rolname, $l),
       format('alter default privileges for role %I grant usage on schemas to %I', rolname, $l)
  from pg_roles
 where rolname !~ '^pg_' and rolname <> $l and oid in (
       select datdba from pg_database where datname = current_database()
       union select nspowner from pg_namespace where $USER_SCHEMAS
       union select c.relowner from pg_class c join pg_namespace on pg_namespace.oid = c.relnamespace
              where $USER_SCHEMAS and c.relkind in ('r', 'p', 'v', 'm', 'f', 'S')) \gexec
SQL
  ok "$role can read $db"
}

revoke_read_only() {
  local role=$1 db=$2 r l
  r=$(sql_ident "$role") l=$(sql_lit "$role")
  if [[ $db == all ]]; then
    if ((${PG_VERSION%%.*} >= 14)); then psql_q "revoke pg_read_all_data from $r" >/dev/null; fi
    ok "$role no longer reads every database"
    return 0
  fi
  psql_script "$db" >/dev/null <<SQL
revoke connect on database $(sql_ident "$db") from $r;
select format('revoke all on all tables in schema %I from %I', nspname, $l),
       format('revoke all on all sequences in schema %I from %I', nspname, $l),
       format('revoke all on schema %I from %I', nspname, $l)
  from pg_namespace where $USER_SCHEMAS \gexec
select distinct format('alter default privileges for role %I%s revoke all on %s from %I',
         pg_get_userbyid(d.defaclrole),
         case when d.defaclnamespace <> 0 then format(' in schema %I', n.nspname) else '' end,
         case d.defaclobjtype when 'r' then 'tables' when 'S' then 'sequences' when 'f' then 'functions'
                              when 'T' then 'types' when 'n' then 'schemas' end,
         $l)
  from pg_default_acl d left join pg_namespace n on n.oid = d.defaclnamespace, aclexplode(d.defaclacl) a
 where a.grantee = (select oid from pg_roles where rolname = $l) \gexec
SQL
  ok "$role can no longer read $db"
}

drop_role() {
  local r dbs=() db
  r=$(sql_ident "$1")
  psql_q "select pg_terminate_backend(pid) from pg_stat_activity where usename = $(sql_lit "$1")" >/dev/null
  mapfile -t dbs < <(list_databases)
  for db in "${dbs[@]}"; do
    printf '%s\n' "reassign owned by $r to current_user;" "drop owned by $r;" | psql_script "$db" >/dev/null
  done
  psql_q "drop role $r" >/dev/null
}

roles_info() {
  psql_q "select r.rolname,
      coalesce(nullif(concat_ws(', ',
        case when r.rolsuper then 'superuser' end,
        case when s.setconfig @> array['default_transaction_read_only=on'] then 'read-only' end,
        case when r.rolcreatedb and not r.rolsuper then 'createdb' end,
        case when not r.rolcanlogin then 'no login' end), ''), '-'),
      coalesce((select string_agg(datname, ', ' order by datname) from pg_database
                 where datdba = r.oid and not datistemplate), '-'),
      coalesce(nullif(concat_ws(', ',
        case when not r.rolsuper and pg_has_role(r.oid, (select oid from pg_roles where rolname = 'pg_read_all_data'), 'member')
             then 'all databases' end,
        (select string_agg(d.datname, ', ' order by d.datname) from pg_database d, aclexplode(d.datacl) a
          where a.grantee = r.oid and a.privilege_type = 'CONNECT' and d.datdba <> r.oid)), ''), '-'),
      (select count(*) from pg_stat_activity where usesysid = r.oid)
    from pg_roles r left join pg_db_role_setting s on s.setrole = r.oid and s.setdatabase = 0
    where r.rolname !~ '^pg_' order by r.rolname"
}

user_list() {
  local name flags owns reads sessions apps line rows=()
  header "Users · PostgreSQL $PG_VERSION/$PG_CLUSTER"
  mapfile -t rows < <(roles_info)
  for line in "${rows[@]}"; do
    IFS=$'\t' read -r name flags owns reads sessions <<<"$line"
    line=""
    if [[ $flags != - ]]; then line+=" · $flags"; fi
    if [[ $owns != - ]]; then line+=" · owns $owns"; fi
    if [[ $reads != - ]]; then line+=" · reads $reads"; fi
    if ((sessions)); then line+=" · $sessions sessions"; fi
    apps=$(apps_using 5 "$name")
    if [[ -n $apps ]]; then line+=" · $(dim "app: $apps")"; fi
    printf '  %s%-20s%s %s\n' "$B" "$name" "$N" "${line# · }"
  done
}

db_list() {
  local name size owner sessions readers apps rows=() line
  header "Databases · PostgreSQL $PG_VERSION/$PG_CLUSTER"
  mapfile -t rows < <(psql_q "select d.datname, pg_size_pretty(pg_database_size(d.oid)), pg_get_userbyid(d.datdba),
      (select count(*) from pg_stat_activity a where a.datid = d.oid),
      coalesce((select string_agg(r.rolname, ', ' order by r.rolname) from aclexplode(d.datacl) a
                  join pg_roles r on r.oid = a.grantee
                 where a.privilege_type = 'CONNECT' and a.grantee <> d.datdba), '-')
    from pg_database d where d.datallowconn and not d.datistemplate order by d.datname")
  printf '  %s%-24s %9s  %-16s %8s  %s%s\n' "$D" Database Size Owner Sessions "Read-only users · apps" "$N"
  for line in "${rows[@]}"; do
    IFS=$'\t' read -r name size owner sessions readers <<<"$line"
    apps=$(apps_using 4 "$name")
    if [[ $readers == - ]]; then readers=""; fi
    if [[ -n $apps ]]; then readers+="${readers:+ · }$(dim "app: $apps")"; fi
    printf '  %-24s %9s  %-16s %8s  %s\n' "$name" "$size" "$owner" "$sessions" "$readers"
  done
}

env_files() {
  find /home /var/www -mindepth 2 -maxdepth 3 -name .env -type f 2>/dev/null | sort || true
}

env_get() {
  sed -nE "s/^[[:space:]]*(export[[:space:]]+)?$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null | tail -n1 |
    sed -E 's/[[:space:]]+#.*$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/'
}

scan_apps() {
  local f
  while IFS= read -r f; do
    [[ -n $f && $(env_get "$f" DB_CONNECTION) == pgsql ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s:%s\n' "$(dirname "$f")" "$(env_get "$f" APP_NAME)" "$(env_get "$f" APP_ENV)" \
      "$(env_get "$f" DB_DATABASE)" "$(env_get "$f" DB_USERNAME)" "$(env_get "$f" DB_HOST)" "$(env_get "$f" DB_PORT)"
  done < <(env_files)
}

app_databases() {
  local db out=""
  while IFS= read -r db; do
    if [[ -n $db ]] && database_exists "$db"; then out+="${out:+ }$db"; fi
  done < <(scan_apps | cut -f4 | sort -u)
  printf '%s' "$out"
}

detect_r2_account() {
  local f
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    grep -hoE '[0-9a-f]{32}\.((eu|fedramp)\.)?r2\.cloudflarestorage\.com' "$f" 2>/dev/null | head -n1 | cut -d. -f1
  done < <(env_files) | head -n1
}

config_defaults() {
  local cpus
  cpus=$(nproc 2>/dev/null || echo 2)
  : "${PG_VERSION:=}" "${PG_CLUSTER:=}" "${STANZA:=}"
  : "${REPO_TYPE:=r2}" "${R2_ACCOUNT_ID:=}" "${R2_JURISDICTION:=default}"
  : "${S3_ENDPOINT:=}" "${S3_REGION:=auto}" "${S3_BUCKET:=}" "${S3_KEY:=}" "${S3_SECRET:=}" "${S3_URI_STYLE:=path}"
  : "${REPO_PATH:=}" "${CIPHER_PASS:=}"
  : "${RETENTION_DAYS:=30}" "${ARCHIVE_TIMEOUT:=60}" "${ARCHIVE_QUEUE_MAX:=8GB}"
  : "${PROCESS_MAX:=$(((cpus / 4) < 1 ? 1 : ((cpus / 4) > 4 ? 4 : cpus / 4)))}" "${COMPRESS_LEVEL:=3}"
  : "${HEARTBEAT_URL:=}"
  if [[ -z ${FULL_SCHEDULE+x} ]]; then FULL_SCHEDULE="30 1 * * 0"; fi
  if [[ -z ${DIFF_SCHEDULE+x} ]]; then DIFF_SCHEDULE="30 1 * * 1-6"; fi
  if [[ -z ${INCR_SCHEDULE+x} ]]; then INCR_SCHEDULE=""; fi
}

CONFIGURED=0
load_config() {
  if [[ -f $CONF_FILE ]]; then
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    CONFIGURED=1
  fi
  config_defaults
}

save_config() {
  local tmp k
  install -d -m 0700 "$CONF_DIR"
  tmp=$(mktemp "$CONF_DIR/.backup.conf.XXXXXX")
  {
    echo "# postgres-manager settings — change via: postgres-manager edit"
    for k in "${CONFIG_KEYS[@]}"; do printf '%s=%q\n' "$k" "${!k}"; done
  } >"$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$CONF_FILE"
  CONFIGURED=1
}

require_configured() {
  ((CONFIGURED)) || die "Backups are not configured yet — run: postgres-manager setup"
}

repo_label() {
  case $REPO_TYPE in
    r2) printf 'R2%s %s%s' "$([[ $R2_JURISDICTION != default ]] && printf ' (%s)' "$R2_JURISDICTION")" "$S3_BUCKET" "$REPO_PATH" ;;
    s3) printf 'S3 %s/%s%s' "$S3_ENDPOINT" "$S3_BUCKET" "$REPO_PATH" ;;
    posix) printf 'local %s' "$REPO_PATH" ;;
  esac
}

schedule_line() {
  local heartbeat_txt="heartbeat off"
  if [[ -n $HEARTBEAT_URL ]]; then heartbeat_txt="heartbeat on"; fi
  printf 'full %s · diff %s · incr %s · %s' "$(describe_cron "$FULL_SCHEDULE")" "$(describe_cron "$DIFF_SCHEDULE")" \
    "$(describe_cron "$INCR_SCHEDULE")" "$heartbeat_txt"
}

apply_config() {
  save_config
  render_pgbackrest_conf
  write_cron
}

ext_label() {
  case $1 in
    postgis) echo "PostGIS — geospatial types, functions, indexes" ;;
    pgvector) echo "pgvector — vector similarity search (AI embeddings)" ;;
    timescaledb) echo "TimescaleDB — time-series hypertables" ;;
    pg_cron) echo "pg_cron — cron jobs inside PostgreSQL" ;;
    pg_stat_statements) echo "pg_stat_statements — query statistics" ;;
  esac
}

ext_package() {
  case $1 in
    postgis) echo "postgresql-$PG_VERSION-postgis-3" ;;
    pgvector) echo "postgresql-$PG_VERSION-pgvector" ;;
    timescaledb) echo "timescaledb-2-postgresql-$PG_VERSION" ;;
    pg_cron) echo "postgresql-$PG_VERSION-cron" ;;
    *) echo "" ;;
  esac
}

ext_sql_name() {
  case $1 in
    pgvector) echo vector ;;
    *) echo "$1" ;;
  esac
}

ext_needs_preload() {
  [[ $1 == timescaledb || $1 == pg_cron || $1 == pg_stat_statements ]]
}

ext_installed() {
  [[ -f "$PG_SHARE/extension/$(ext_sql_name "$1").control" ]]
}

preload_has() {
  [[ ",$(tr -d ' ' <<<"$1")," == *",$2,"* ]]
}

ext_databases() {
  local sql db out=""
  sql=$(ext_sql_name "$1")
  while IFS= read -r db; do
    [[ -n $db ]] || continue
    if [[ -n $(psql_q "select 1 from pg_extension where extname = '$sql'" "$db" 2>/dev/null || true) ]]; then
      out+="${out:+, }$db"
    fi
  done < <(list_databases)
  printf '%s' "$out"
}

ext_state() {
  local key=$1 preload=$2 state dbs
  if ext_installed "$key"; then state=$(good installed); else state=$(dim "not installed"); fi
  if ext_needs_preload "$key"; then
    if preload_has "$preload" "$key"; then state+=" · $(good preloaded)"; else state+=" · $(dim "not preloaded")"; fi
  fi
  dbs=$(ext_databases "$key")
  if [[ -n $dbs ]]; then state+=" · in $dbs"; fi
  printf '%s' "$state"
}

ensure_ext_package() {
  local pkg
  pkg=$(ext_package "$1")
  [[ -n $pkg ]] || return 0
  if [[ $1 == timescaledb ]]; then
    ensure_timescale_repo
  elif ! pkg_available "$pkg"; then
    apt_update
    if ! pkg_available "$pkg"; then ensure_pgdg_repo || true; fi
  fi
  pkg_available "$pkg" || die "Package $pkg is not available for $OS_PRETTY"
  apt_install "$pkg"
}

hb() {
  if [[ ${1-} =~ ^[0-9]+$ ]]; then
    numfmt --to=iec-i --suffix=B --format='%.1f' "$1" | sed -E 's/\.0([KMGTP]?i?B)$/\1/'
  else
    printf '%s' "${1:-?}"
  fi
}

ago() {
  local s=$(($(date +%s) - $1))
  if ((s < 0)); then s=0; fi
  if ((s < 90)); then
    printf '%ss' "$s"
  elif ((s < 5400)); then
    printf '%sm' "$((s / 60))"
  elif ((s < 172800)); then
    printf '%sh %sm' "$((s / 3600))" "$((s % 3600 / 60))"
  else
    printf '%sd %sh' "$((s / 86400))" "$((s % 86400 / 3600))"
  fi
}

duration() {
  ago $(($(date +%s) - $1))
}

fmt_ts() { date -d "@$1" '+%Y-%m-%d %H:%M'; }

describe_cron() {
  local expr=$1 m h dom mon dow t
  if [[ -z $expr ]]; then
    printf 'off'
    return
  fi
  read -r m h dom mon dow <<<"$expr"
  if [[ $dom == '*' && $mon == '*' && $m =~ ^[0-9]+$ ]]; then
    if [[ $h =~ ^[0-9]+$ ]]; then
      t=$(printf '%02d:%02d' "$((10#$h))" "$((10#$m))")
      case $dow in
        '*') printf 'daily %s' "$t" ;;
        0 | 7) printf 'Sun %s' "$t" ;;
        1-6) printf 'Mon–Sat %s' "$t" ;;
        *) printf '%s (dow %s)' "$t" "$dow" ;;
      esac
      return
    elif [[ $h == '*' && $dow == '*' ]]; then
      printf 'hourly at :%02d' "$((10#$m))"
      return
    fi
  fi
  printf '%s' "$expr"
}

version_ge() {
  [[ $(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1) == "$2" ]]
}

random_secret() {
  head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | head -c "${1:-32}"
}

menu_items() {
  while (($# >= 3)); do
    printf '  %s%s)%s %-26s %s%s%s\n' "$B" "$1" "$N" "$2" "$D" "$3" "$N"
    shift 3
  done
}

menu_choice() {
  local __mc_reply="" __mc_rc=0
  printf 'Choose %s(ESC = back)%s: ' "$D" "$N"
  read_input __mc_reply || __mc_rc=$?
  if ((__mc_rc == 1)); then return 1; fi
  if ((__mc_rc == 2)); then __mc_reply=b; fi
  printf -v "$1" '%s' "$__mc_reply"
}

run_cmd() {
  local rc=0
  PGM_CLUSTER="$PG_VERSION/$PG_CLUSTER" "$SELF" "$@" || rc=$?
  if ((rc == 130)); then
    info "Cancelled — back to the menu"
  elif ((rc)); then
    warn "${*:1:2} ended with exit code $rc"
  fi
}

info() { printf '%s▸%s %s\n' "$C" "$N" "$*"; }
ok() { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die() {
  printf '%s✗ %s%s\n' "$R" "$*" "$N" >&2
  exit 1
}
header() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
row() { printf '  %s%-11s%s %s\n' "$D" "$1" "$N" "$2"; }
good() { printf '%s%s%s' "$G" "$*" "$N"; }
bad() { printf '%s%s%s' "$R" "$*" "$N"; }
meh() { printf '%s%s%s' "$Y" "$*" "$N"; }
dim() { printf '%s%s%s' "$D" "$*" "$N"; }

pgbr() {
  as_postgres pgbackrest --stanza="$STANZA" "$@"
}

pgbr_version() {
  if command -v pgbackrest >/dev/null; then pgbackrest version 2>/dev/null | awk '{print $2}'; fi
}

repo_reachable() {
  as_postgres pgbackrest --log-level-console=warn repo-ls >/dev/null
}

pgbr_info_json() {
  pgbr --output=json --log-level-console=off info 2>/dev/null || true
}

latest_backup_size() {
  jq -r '.[0].backup | last | .info.size // 0' <<<"$(pgbr_info_json)"
}

render_pgbackrest_conf() {
  local tmp pgbr_ver
  pgbr_ver=$(pgbr_version)
  install -d -m 0750 -o root -g postgres "$PGBR_CONF_DIR"
  install -d -m 0750 -o postgres -g postgres "$PGBR_LOG_DIR" "$PGBR_SPOOL_DIR"
  if [[ $REPO_TYPE == posix ]]; then install -d -m 0750 -o postgres -g postgres "$REPO_PATH"; fi
  tmp=$(mktemp)
  {
    echo "# Managed by postgres-manager — change via: postgres-manager edit (manual edits are overwritten)"
    echo "[global]"
    case $REPO_TYPE in
      r2 | s3)
        printf '%s\n' "repo1-type=s3" "repo1-s3-endpoint=$S3_ENDPOINT" "repo1-s3-region=$S3_REGION" \
          "repo1-s3-bucket=$S3_BUCKET" "repo1-s3-key=$S3_KEY" "repo1-s3-key-secret=$S3_SECRET" \
          "repo1-s3-uri-style=$S3_URI_STYLE" "repo1-path=$REPO_PATH"
        ;;
      posix) printf '%s\n' "repo1-type=posix" "repo1-path=$REPO_PATH" ;;
    esac
    printf '%s\n' "repo1-cipher-type=aes-256-cbc" "repo1-cipher-pass=$CIPHER_PASS" \
      "repo1-retention-full-type=time" "repo1-retention-full=$RETENTION_DAYS"
    if [[ -n $pgbr_ver ]] && version_ge "$pgbr_ver" "$PGBR_MIN_BLOCK_VERSION"; then
      printf '%s\n' "repo1-bundle=y" "repo1-block=y"
    fi
    printf '%s\n' "compress-type=zst" "compress-level=$COMPRESS_LEVEL" "process-max=$PROCESS_MAX" \
      "start-fast=y" "delta=y" "archive-async=y" "archive-push-queue-max=$ARCHIVE_QUEUE_MAX" \
      "spool-path=$PGBR_SPOOL_DIR" "log-path=$PGBR_LOG_DIR" "log-level-file=info"
    echo
    echo "[$STANZA]"
    printf '%s\n' "pg1-path=$PG_DATA" "pg1-port=$PG_PORT" "pg1-socket-path=$(pg_socket_dir)"
  } >"$tmp"
  install -m 0640 -o root -g postgres "$tmp" "$PGBR_CONF"
  rm -f "$tmp"
}

ARCHIVE_NEEDS_RESTART=0
write_archive_snippet() {
  local wal_level archive_mode extra=""
  wal_level=$(pg_setting wal_level)
  archive_mode=$(pg_setting archive_mode)
  if [[ $wal_level == minimal ]]; then extra=$'\nwal_level = replica'; fi
  write_pg_snippet "$PG_SNIPPET_ARCHIVE" "# Managed by postgres-manager — WAL archiving to pgBackRest (point-in-time recovery).
# Change via: postgres-manager edit
archive_mode = on
archive_command = 'pgbackrest --stanza=$STANZA archive-push %p'
archive_timeout = ${ARCHIVE_TIMEOUT}s$extra"
  ARCHIVE_NEEDS_RESTART=0
  if [[ $archive_mode != on || $wal_level == minimal ]]; then ARCHIVE_NEEDS_RESTART=1; fi
}

write_cron() {
  local cmd="$INSTALL_PATH cron-backup" type var
  {
    echo "# Managed by postgres-manager — change via: postgres-manager edit"
    echo "SHELL=/bin/bash"
    echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    for type in full diff incr; do
      var="${type^^}_SCHEDULE"
      if [[ -n ${!var} ]]; then echo "${!var} root $cmd $type 2>&1 | logger -t postgres-manager"; fi
    done
  } >"$CRON_FILE"
  chmod 0644 "$CRON_FILE"
}

install_self() {
  if [[ -f $SELF && $SELF != "$INSTALL_PATH" ]]; then
    install -m 0755 "$SELF" "$INSTALL_PATH"
    ok "Installed $INSTALL_PATH"
  elif [[ ! -x $INSTALL_PATH ]]; then
    warn "Could not install myself to $INSTALL_PATH (cron needs it) — copy this script there manually"
  fi
}

heartbeat() {
  if [[ -n $HEARTBEAT_URL ]]; then
    curl -fsS -m 10 --retry 3 -o /dev/null "${HEARTBEAT_URL%/}$1" || warn "Heartbeat ping failed"
  fi
}

backup_lock() {
  exec 9>"$LOCK_FILE"
  if [[ $1 == try ]]; then
    flock -n 9
  else
    flock -w 14400 9
  fi
}

backup_unlock() {
  flock -u 9 || true
  exec 9>&-
}

run_backup() {
  local type=$1
  backup_lock wait || die "Another backup is still running"
  info "Running $type backup (stanza $STANZA → $(repo_label))"
  pgbr --type="$type" --log-level-console=info backup
  backup_unlock
  ok "$type backup finished"
}

as_postgres() { runuser -u postgres -- "$@"; }

psql_q() {
  as_postgres psql -XAtq -v ON_ERROR_STOP=1 -p "$PG_PORT" -d "${2:-postgres}" -F $'\t' -c "$1"
}

pg_ready() {
  as_postgres "$PG_BIN/pg_isready" -q -p "$PG_PORT" >/dev/null 2>&1
}

wait_ready() {
  local timeout=${1:-120} i
  for ((i = 0; i < timeout; i++)); do
    if pg_ready; then return 0; fi
    sleep 1
  done
  die "PostgreSQL did not become ready within ${timeout}s"
}

detect_cluster() {
  command -v pg_lsclusters >/dev/null || die "pg_lsclusters not found — is PostgreSQL (postgresql-common) installed?"
  local rows=() labels=() r sel="" pick v c p s
  mapfile -t rows < <(pg_lsclusters -h 2>/dev/null | awk '{print $1" "$2" "$3" "$4" "$6}')
  ((${#rows[@]})) || die "No PostgreSQL cluster found (pg_lsclusters is empty)"
  # Child processes of the menu inherit the cluster picked there
  if [[ -z $PG_VERSION && ${PGM_CLUSTER-} == */* ]]; then
    PG_VERSION=${PGM_CLUSTER%%/*} PG_CLUSTER=${PGM_CLUSTER#*/}
  fi
  if [[ -n $PG_VERSION && -n $PG_CLUSTER ]]; then
    for r in "${rows[@]}"; do
      if [[ $r == "$PG_VERSION $PG_CLUSTER "* ]]; then sel=$r; fi
    done
    if [[ -z $sel ]]; then warn "Configured cluster $PG_VERSION/$PG_CLUSTER not found"; fi
  fi
  if [[ -z $sel ]]; then
    if ((${#rows[@]} == 1)); then
      sel=${rows[0]}
    else
      header "Multiple PostgreSQL clusters"
      for r in "${rows[@]}"; do
        read -r v c p s _ <<<"$r"
        labels+=("$v/$c (port $p, $s)")
      done
      choose pick "Cluster to manage" 1 "${labels[@]}"
      sel=${rows[pick - 1]}
    fi
  fi
  read -r PG_VERSION PG_CLUSTER PG_PORT PG_STATUS PG_DATA <<<"$sel"
  PG_BIN="/usr/lib/postgresql/$PG_VERSION/bin"
  PG_ETC="/etc/postgresql/$PG_VERSION/$PG_CLUSTER"
  PG_SHARE="/usr/share/postgresql/$PG_VERSION"
}

pg_restart() {
  info "Restarting PostgreSQL $PG_VERSION/$PG_CLUSTER"
  # fd 9 is the backup lock; the postmaster must not inherit it
  pg_ctlcluster "$PG_VERSION" "$PG_CLUSTER" restart 9>&-
  wait_ready 300
  ok "PostgreSQL restarted"
}

pg_reload() {
  psql_q "select pg_reload_conf()" >/dev/null
}

pg_setting() {
  psql_q "select setting from pg_settings where name = '$1'" 2>/dev/null || true
}

pg_socket_dir() {
  local dirs
  dirs=$(pg_setting unix_socket_directories)
  dirs=${dirs%%,*}
  printf '%s' "${dirs:-/var/run/postgresql}"
}

list_databases() {
  psql_q "select datname from pg_database where datallowconn and not datistemplate order by datname"
}

database_exists() {
  list_databases | grep -Fx -- "$1" >/dev/null
}

ensure_conf_d() {
  local conf="$PG_ETC/postgresql.conf"
  [[ -f $conf ]] || die "$conf not found"
  if ! grep -Eq "^[[:space:]]*include_dir[[:space:]]*=[[:space:]]*'conf\.d'" "$conf"; then
    info "Adding include_dir = 'conf.d' to $conf"
    printf "\n# Added by postgres-manager\ninclude_dir = 'conf.d'\n" >>"$conf"
  fi
  install -d -o postgres -g postgres -m 0755 "$PG_ETC/conf.d"
}

write_pg_snippet() {
  local file=$1 content=$2
  ensure_conf_d
  printf '%s\n' "$content" >"$PG_ETC/conf.d/$file"
  chown postgres:postgres "$PG_ETC/conf.d/$file"
  pg_reload
  check_overrides "$file"
}

check_overrides() {
  local snippet=$1 name src names=()
  mapfile -t names < <(psql_q "select distinct name from pg_file_settings where sourcefile like '%/$snippet' and not applied and error is null")
  for name in "${names[@]}"; do
    [[ -n $name ]] || continue
    src=$(psql_q "select sourcefile from pg_file_settings where name = '$name' order by seqno desc limit 1")
    if [[ $src == */postgresql.auto.conf ]]; then
      warn "$name is overridden by ALTER SYSTEM ($src)"
      if confirm "Run ALTER SYSTEM RESET $name so $snippet applies?" Y; then
        psql_q "alter system reset $name" >/dev/null
        pg_reload
      fi
    else
      warn "$name in $snippet is overridden by $src — remove it there"
    fi
  done
}

require_pg() {
  pg_ready || die "PostgreSQL $PG_VERSION/$PG_CLUSTER is not running"
}

sql_ident() { printf '"%s"' "${1//\"/\"\"}"; }
sql_lit() { printf "'%s'" "${1//\'/\'\'}"; }

psql_script() {
  as_postgres psql -XAtq -v ON_ERROR_STOP=1 -p "$PG_PORT" -d "${1:-postgres}" -F $'\t'
}

psql_secret() {
  printf '%s\n' "set log_statement = 'none';" "set log_min_duration_statement = -1;" \
    "set log_min_error_statement = 'panic';" "set pg_stat_statements.track_utility = off;" "$1;" |
    psql_script >/dev/null
}

role_exists() {
  [[ -n $(psql_q "select 1 from pg_roles where rolname = $(sql_lit "$1")") ]]
}

valid_name() {
  [[ $1 =~ ^[a-z_][a-z0-9_]{0,62}$ ]]
}

read_input() {
  local __ri_line="" __ri_rc=0
  if [[ ! -t 0 ]]; then
    IFS= read -r __ri_line || [[ -n $__ri_line ]] || return 1
    if [[ $__ri_line == *$'\e'* ]]; then return 2; fi
    printf -v "$1" '%s' "$__ri_line"
    return 0
  fi
  local __ri_tty
  __ri_tty=$(stty -g)
  # echo off for the whole prompt (pasted secrets never show), restored on Ctrl-C too
  trap 'stty "$__ri_tty"; printf "\n"; exit 130' INT TERM
  stty -echo -icanon min 1 time 0
  read_keys __ri_line "${2-}" || __ri_rc=$?
  stty "$__ri_tty"
  trap - INT TERM
  printf '\n'
  if ((__ri_rc)); then return "$__ri_rc"; fi
  printf -v "$1" '%s' "$__ri_line"
}

read_keys() {
  local __rk_line="" __rk_c="" __rk_rest=""
  while :; do
    IFS= read -rn1 __rk_c || return 1
    case $__rk_c in
      '') break ;;
      $'\e')
        __rk_rest=""
        IFS= read -rn5 -t 0.05 __rk_rest || true
        if [[ -z $__rk_rest ]]; then return 2; fi
        ;;
      $'\004')
        if [[ -z $__rk_line ]]; then return 1; fi
        ;;
      $'\177' | $'\b')
        if [[ -n $__rk_line ]]; then
          __rk_line=${__rk_line%?}
          if [[ -z $2 ]]; then printf '\b \b'; fi
        fi
        ;;
      [[:cntrl:]]) ;;
      *)
        __rk_line+=$__rk_c
        if [[ -z $2 ]]; then printf '%s' "$__rk_c"; fi
        ;;
    esac
  done
  printf -v "$1" '%s' "$__rk_line"
}

cancel() {
  printf '%s↩ cancelled%s\n' "$D" "$N"
  exit 130
}

read_line() {
  local __rl_rc=0
  read_input "$@" || __rl_rc=$?
  case $__rl_rc in
    1) die "No input (stdin closed)" ;;
    2) cancel ;;
  esac
}

ask() {
  local __ask_var=$1 __ask_prompt=$2 __ask_def=${3-} __ask_reply
  if [[ -n $__ask_def ]]; then
    printf '%s %s[%s]%s: ' "$__ask_prompt" "$D" "$__ask_def" "$N"
  else
    printf '%s: ' "$__ask_prompt"
  fi
  read_line __ask_reply
  printf -v "$__ask_var" '%s' "${__ask_reply:-$__ask_def}"
}

ask_secret() {
  local __sec_var=$1 __sec_prompt=$2 __sec_cur=${3-} __sec_reply __sec_hint=""
  if [[ -n $__sec_cur ]]; then __sec_hint=" ${D}[keep current]${N}"; fi
  printf '%s%s: ' "$__sec_prompt" "$__sec_hint"
  read_line __sec_reply secret
  printf -v "$__sec_var" '%s' "${__sec_reply:-$__sec_cur}"
}

confirm() {
  local __cf_def=${2:-N} __cf_reply __cf_opts="y/N"
  if [[ $__cf_def == Y ]]; then __cf_opts="Y/n"; fi
  printf '%s %s[%s]%s: ' "$1" "$D" "$__cf_opts" "$N"
  read_line __cf_reply
  __cf_reply=${__cf_reply:-$__cf_def}
  [[ $__cf_reply =~ ^[Yy] ]]
}

choose() {
  local __ch_var=$1 __ch_prompt=$2 __ch_def=$3 __ch_i=1 __ch_opt __ch_reply
  shift 3
  for __ch_opt in "$@"; do
    printf '  %s%d)%s %s\n' "$B" "$__ch_i" "$N" "$__ch_opt"
    __ch_i=$((__ch_i + 1))
  done
  while :; do
    ask __ch_reply "$__ch_prompt" "$__ch_def"
    if [[ $__ch_reply =~ ^[0-9]+$ ]] && ((__ch_reply >= 1 && __ch_reply <= $#)); then break; fi
    warn "Pick 1-$#"
  done
  printf -v "$__ch_var" '%s' "$__ch_reply"
}

ask_int() {
  local __int_var=$1 __int_prompt=$2 __int_def=$3 __int_min=${4:-0} __int_max=${5:-999999} __int_reply
  while :; do
    ask __int_reply "$__int_prompt" "$__int_def"
    if [[ $__int_reply =~ ^[0-9]+$ ]] && ((__int_reply >= __int_min && __int_reply <= __int_max)); then break; fi
    warn "Enter a number between $__int_min and $__int_max"
  done
  printf -v "$__int_var" '%s' "$__int_reply"
}

pick_item() {
  local __pi_var=$1 __pi_prompt=$2 __pi_reply="" __pi_i=1 __pi_it
  shift 2
  (($#)) || die "Nothing to choose from"
  local __pi_items=("$@")
  for __pi_it in "$@"; do
    printf '  %s%d)%s %s\n' "$B" "$__pi_i" "$N" "$__pi_it"
    __pi_i=$((__pi_i + 1))
  done
  while :; do
    ask __pi_reply "$__pi_prompt (number or name)"
    if [[ $__pi_reply =~ ^[0-9]+$ ]] && ((__pi_reply >= 1 && __pi_reply <= $#)); then
      __pi_reply=${__pi_items[__pi_reply - 1]}
      break
    fi
    for __pi_it in "$@"; do
      if [[ $__pi_it == "$__pi_reply" ]]; then break 2; fi
    done
    warn "Pick 1-$# or a name from the list"
  done
  printf -v "$__pi_var" '%s' "$__pi_reply"
}

restore_into_dir() {
  local dir=$1
  shift
  if [[ -d $dir && -n $(ls -A "$dir" 2>/dev/null) ]]; then die "$dir is not empty"; fi
  install -d -o postgres -g postgres -m 0700 "$dir"
  info "Restoring into $dir"
  pgbr --pg1-path="$dir" --archive-mode=off --log-level-console=info "$@" restore
}

write_standalone_conf() {
  local dir=$1 port=$2 preload
  preload=$(pg_setting shared_preload_libraries)
  if [[ -f $dir/postgresql.conf ]]; then mv "$dir/postgresql.conf" "$dir/postgresql.conf.orig"; fi
  {
    echo "# Written by postgres-manager for a restored copy — not the live cluster."
    echo "listen_addresses = ''"
    echo "port = $port"
    echo "unix_socket_directories = '$dir'"
    echo "shared_buffers = 256MB"
    # recovery requires these to be >= the values on the source cluster
    echo "max_connections = $(pg_setting max_connections)"
    echo "max_worker_processes = $(pg_setting max_worker_processes)"
    echo "max_locks_per_transaction = $(pg_setting max_locks_per_transaction)"
    echo "max_prepared_transactions = $(pg_setting max_prepared_transactions)"
    echo "max_wal_senders = $(pg_setting max_wal_senders)"
    echo "shared_preload_libraries = '$preload'"
    echo "archive_mode = off"
    echo "hot_standby = off"
    echo "logging_collector = off"
    if [[ $preload == *timescaledb* ]]; then echo "timescaledb.max_background_workers = 0"; fi
    if [[ $preload == *pg_cron* ]]; then echo "cron.database_name = '$(pg_setting cron.database_name)'"; fi
  } >"$dir/postgresql.conf"
  echo "local all all peer" >"$dir/pg_hba.conf"
  : >"$dir/pg_ident.conf"
  chown postgres:postgres "$dir/postgresql.conf" "$dir/pg_hba.conf" "$dir/pg_ident.conf"
}

start_standalone() {
  local dir=$1 port=$2 waited=0
  info "Starting restored copy (port $port, socket in $dir) — replays WAL, may take a while"
  as_postgres "$PG_BIN/pg_ctl" -D "$dir" -l "$dir/postgres-manager.log" -W -s start
  until as_postgres "$PG_BIN/pg_isready" -q -h "$dir" -p "$port" >/dev/null 2>&1; do
    if ((waited > 2)) && [[ ! -f $dir/postmaster.pid ]]; then
      tail -n 30 "$dir/postgres-manager.log" >&2 || true
      die "Restored copy stopped during recovery (log: $dir/postgres-manager.log)"
    fi
    sleep 2
    waited=$((waited + 2))
    if ((waited % 60 == 0)); then info "still recovering ($(duration "$waited"))"; fi
  done
}

stop_standalone() {
  as_postgres "$PG_BIN/pg_ctl" -D "$1" -m fast -w -s stop >/dev/null 2>&1 || true
}

standalone_psql() {
  as_postgres psql -XAtq -h "$1" -p "$2" -d "$3" -c "$4" 2>/dev/null
}

disk_check() {
  local dir=$1 need=$2 avail
  avail=$(df -B1 --output=avail "$dir" | tail -n1 | tr -d ' ')
  if ((need * 11 / 10 > avail)); then
    die "Not enough space in $dir: need ~$(hb "$need"), $(hb "$avail") free"
  fi
}

recovered_until() {
  local log=$1 line
  line=$(grep -oE 'last completed transaction was at log time .*' "$log" | tail -n1 | sed 's/.*log time //' || true)
  if [[ -z $line ]]; then
    line=$(grep -oE '(recovery stopping .*|redo done at [0-9A-F/]+)' "$log" | tail -n1 || true)
  fi
  printf '%s' "${line:-unknown}"
}

prompt_repository() {
  local pick def=1
  header "Backup repository"
  case $REPO_TYPE in s3) def=2 ;; posix) def=3 ;; esac
  choose pick "Repository type" "$def" "Cloudflare R2" "Other S3-compatible (AWS, Hetzner Object Storage, MinIO …)" "Local or mounted directory"
  case $pick in
    1) prompt_r2 ;;
    2) prompt_s3 ;;
    3) REPO_TYPE=posix ;;
  esac
  if [[ $REPO_TYPE == posix ]]; then
    ask REPO_PATH "Repository directory" "${REPO_PATH:-/var/lib/pgbackrest}"
  else
    [[ -n $S3_BUCKET ]] || die "Bucket name is required"
    if [[ -z $REPO_PATH || $REPO_PATH == /var/lib/pgbackrest ]]; then REPO_PATH="/$(hostname -s)"; fi
    ask REPO_PATH "Path prefix inside the bucket" "$REPO_PATH"
  fi
  if [[ $REPO_PATH != /* ]]; then REPO_PATH="/$REPO_PATH"; fi
}

prompt_r2() {
  local detected="" jur jdef=1
  REPO_TYPE=r2
  if [[ -z $R2_ACCOUNT_ID ]]; then detected=$(detect_r2_account || true); fi
  if [[ -n $detected ]]; then info "Found R2 account id $detected in an app .env"; fi
  while :; do
    ask R2_ACCOUNT_ID "Cloudflare account ID" "${R2_ACCOUNT_ID:-$detected}"
    if [[ $R2_ACCOUNT_ID =~ ^[0-9a-f]{32}$ ]]; then break; fi
    warn "Expected a 32-character hex account id"
  done
  case $R2_JURISDICTION in eu) jdef=2 ;; fedramp) jdef=3 ;; esac
  choose jur "Bucket jurisdiction (must match how the bucket was created)" "$jdef" "default" "eu" "fedramp"
  case $jur in
    1) R2_JURISDICTION=default S3_ENDPOINT="$R2_ACCOUNT_ID.r2.cloudflarestorage.com" ;;
    2) R2_JURISDICTION=eu S3_ENDPOINT="$R2_ACCOUNT_ID.eu.r2.cloudflarestorage.com" ;;
    3) R2_JURISDICTION=fedramp S3_ENDPOINT="$R2_ACCOUNT_ID.fedramp.r2.cloudflarestorage.com" ;;
  esac
  S3_REGION=auto
  S3_URI_STYLE=path
  ask S3_BUCKET "Bucket name" "$S3_BUCKET"
  info "Use an R2 API token with \"Object Read & Write\" on this bucket only."
  ask S3_KEY "Access key ID" "$S3_KEY"
  ask_secret S3_SECRET "Secret access key" "$S3_SECRET"
}

prompt_s3() {
  local style
  REPO_TYPE=s3
  ask S3_ENDPOINT "Endpoint host (no https://, e.g. fsn1.your-objectstorage.com)" "$S3_ENDPOINT"
  S3_ENDPOINT=${S3_ENDPOINT#https://}
  S3_ENDPOINT=${S3_ENDPOINT%/}
  ask S3_REGION "Region" "$S3_REGION"
  ask S3_BUCKET "Bucket name" "$S3_BUCKET"
  choose style "URI style" "$([[ $S3_URI_STYLE == host ]] && echo 2 || echo 1)" "path (bucket in path, works everywhere)" "host (virtual-hosted)"
  if [[ $style == 2 ]]; then S3_URI_STYLE=host; else S3_URI_STYLE=path; fi
  ask S3_KEY "Access key ID" "$S3_KEY"
  ask_secret S3_SECRET "Secret access key" "$S3_SECRET"
}

prompt_cipher() {
  local pick
  header "Encryption"
  if [[ -n $CIPHER_PASS ]]; then
    info "Keeping the existing encryption passphrase."
    return 0
  fi
  choose pick "Passphrase" 1 "Generate a new one (new repository)" "Enter an existing one (repository already has backups)"
  if [[ $pick == 2 ]]; then
    ask_secret CIPHER_PASS "Existing passphrase"
    [[ -n $CIPHER_PASS ]] || die "Passphrase is required"
    return 0
  fi
  CIPHER_PASS=$(random_secret 64)
  printf '\n  %s┌──────────────────────────────────────────────────────────────────────────┐%s\n' "$Y" "$N"
  printf '  %s│%s %-73s%s│%s\n' "$Y" "$N" "Encryption passphrase — store it in your password manager NOW." "$Y" "$N"
  printf '  %s│%s %-73s%s│%s\n' "$Y" "$N" "Without it the backups cannot be restored. It is also kept in" "$Y" "$N"
  printf '  %s│%s %-73s%s│%s\n' "$Y" "$N" "$CONF_FILE, which dies with this server." "$Y" "$N"
  printf '  %s└──────────────────────────────────────────────────────────────────────────┘%s\n' "$Y" "$N"
  printf '\n    %s%s%s\n\n' "$B" "$CIPHER_PASS" "$N"
  until confirm "Stored the passphrase safely?" N; do warn "Store it first — it cannot be recovered."; done
}

schedule_time() {
  local m h
  read -r m h _ <<<"${FULL_SCHEDULE:-30 1}"
  if [[ $m =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]]; then
    printf '%02d:%02d' "$((10#$h))" "$((10#$m))"
  else
    printf '01:30'
  fi
}

edit_schedule() {
  local pick t h m
  header "Backup schedule"
  choose pick "Schedule" 1 \
    "Weekly full (Sunday) + daily differential  [recommended]" \
    "Daily full" \
    "Weekly full + daily differential + hourly incremental" \
    "Custom cron expressions"
  if [[ $pick == 4 ]]; then
    edit_custom_schedule
    return 0
  fi
  while :; do
    ask t "Time of day (HH:MM, server time $(date +%Z))" "$(schedule_time)"
    if [[ $t =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then break; fi
    warn "Expected HH:MM"
  done
  h=$((10#${t%%:*}))
  m=$((10#${t##*:}))
  case $pick in
    1) FULL_SCHEDULE="$m $h * * 0" DIFF_SCHEDULE="$m $h * * 1-6" INCR_SCHEDULE="" ;;
    2) FULL_SCHEDULE="$m $h * * *" DIFF_SCHEDULE="" INCR_SCHEDULE="" ;;
    3) FULL_SCHEDULE="$m $h * * 0" DIFF_SCHEDULE="$m $h * * 1-6" INCR_SCHEDULE="$(((m + 30) % 60)) * * * *" ;;
  esac
}

edit_custom_schedule() {
  local expr type var
  for type in full diff incr; do
    var="${type^^}_SCHEDULE"
    while :; do
      ask expr "Cron for $type backups (5 fields, '-' = off)" "${!var:--}"
      if [[ $expr == - ]]; then expr=""; fi
      if [[ -z $expr || $(wc -w <<<"$expr") -eq 5 ]]; then break; fi
      warn "Expected 5 cron fields, e.g. '30 1 * * 0'"
    done
    printf -v "$var" '%s' "$expr"
  done
}

edit_retention() {
  info "Point-in-time recovery stays possible for at least this many days (older backups + WAL expire)."
  ask_int RETENTION_DAYS "Retention in days" "$RETENTION_DAYS" 1 3650
}

edit_rpo() {
  info "archive_timeout forces a WAL switch at least every N seconds = max data loss when the disk dies."
  ask_int ARCHIVE_TIMEOUT "archive_timeout seconds (RPO)" "$ARCHIVE_TIMEOUT" 10 3600
}

edit_performance() {
  ask_int PROCESS_MAX "Parallel backup/restore processes" "$PROCESS_MAX" 1 32
  ask_int COMPRESS_LEVEL "zstd compression level (1 fast … 19 small)" "$COMPRESS_LEVEL" 1 19
}

edit_queue() {
  info "If the repository is unreachable, WAL queues locally up to this size; beyond it WAL is dropped"
  info "(the PITR chain breaks, but the disk does not fill up and PostgreSQL keeps running)."
  ask ARCHIVE_QUEUE_MAX "Max local WAL queue (e.g. 8GB)" "$ARCHIVE_QUEUE_MAX"
}

edit_heartbeat() {
  info "Pinged after every scheduled backup: <url> on success, <url>/fail on failure (healthchecks.io style)."
  ask HEARTBEAT_URL "Heartbeat URL ('-' = off)" "${HEARTBEAT_URL:--}"
  if [[ $HEARTBEAT_URL == - ]]; then HEARTBEAT_URL=""; fi
}

show_status() {
  local load mem_total mem_used
  header "postgres-manager $version · $(hostname -f 2>/dev/null || hostname) · $OS_PRETTY ($(uname -m))"
  load=$(cut -d' ' -f1-3 /proc/loadavg | tr ' ' '/')
  read -r mem_total mem_used < <(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "%.0f %.0f\n", t*1024, (t-a)*1024}' /proc/meminfo)
  row System "load $load · $(nproc) cpu · mem $(hb "$mem_used")/$(hb "$mem_total") · up $(duration "$(cut -d. -f1 /proc/uptime)")"
  row Disk "$(df -hP "$PG_DATA" 2>/dev/null | awk 'NR==2 {print $3"/"$2" used ("$5"), "$4" free on "$6}')"

  if pg_ready; then
    status_postgres
    status_users
    status_apps
    status_archiving
  else
    row Postgres "$PG_VERSION/$PG_CLUSTER port $PG_PORT · $(bad "not accepting connections ($PG_STATUS)")"
  fi
  status_backups
}

status_postgres() {
  local ver up conns maxc active hit longest walsize slots total conn_txt long_txt dbs db exts ext_line=""
  IFS=$'\t' read -r ver up conns maxc active hit longest walsize slots total < <(psql_q "
    select current_setting('server_version'),
           extract(epoch from now() - pg_postmaster_start_time())::bigint,
           (select count(*) from pg_stat_activity where backend_type = 'client backend'),
           current_setting('max_connections'),
           (select count(*) from pg_stat_activity where backend_type = 'client backend' and state <> 'idle'),
           coalesce((select round(100.0 * sum(blks_hit) / nullif(sum(blks_hit) + sum(blks_read), 0), 2) from pg_stat_database), 0),
           coalesce((select extract(epoch from max(now() - xact_start))::bigint from pg_stat_activity
                     where backend_type = 'client backend' and xact_start is not null), 0),
           (select coalesce(sum(size), 0) from pg_ls_waldir()),
           (select count(*) from pg_replication_slots),
           (select sum(pg_database_size(oid)) from pg_database)")

  conn_txt="$conns/$maxc (active $active)"
  if ((conns * 100 / maxc >= 80)); then conn_txt=$(bad "$conn_txt"); fi
  long_txt="longest txn $(duration "$longest")"
  if ((longest > 300)); then long_txt=$(meh "$long_txt"); fi

  row Postgres "${ver%% *} · cluster $PG_VERSION/$PG_CLUSTER · port $PG_PORT · $(good online) · up $(duration "$up")"
  row "" "connections $conn_txt · cache hit ${hit}% · $long_txt"
  row "" "data $(hb "$total") · WAL $(hb "$walsize") · slots $slots · $(dim "$PG_DATA")"

  dbs=$(psql_q "select datname || ' ' || pg_size_pretty(pg_database_size(oid)) from pg_database
                where not datistemplate order by pg_database_size(oid) desc limit 6" | paste -sd ',' - | sed 's/,/, /g')
  row Databases "$dbs"

  while IFS= read -r db; do
    [[ -n $db ]] || continue
    exts=$(psql_q "select string_agg(extname || ' ' || extversion, ', ' order by extname) from pg_extension where extname <> 'plpgsql'" "$db" 2>/dev/null || true)
    if [[ -n $exts ]]; then ext_line+="${ext_line:+ · }$db: $exts"; fi
  done < <(list_databases | head -n 15)
  row Extensions "${ext_line:-none} · $(dim "preload: $(pg_setting shared_preload_libraries)")"
}

status_apps() {
  local site env database user hostport label=Apps
  while IFS=$'\t' read -r site _ env database user hostport; do
    [[ -n $site ]] || continue
    row "$label" "$(basename "$site") → $database $(dim "(user $user @ $hostport${env:+, $env})")"
    label=""
  done < <(scan_apps)
}

status_archiving() {
  local mode timeout count wal last_ts failed fwal fail_ts queued extra=""
  mode=$(pg_setting archive_mode)
  if [[ $mode != on && $mode != always ]]; then
    row Archiving "$(meh off) · no point-in-time recovery"
    return 0
  fi
  timeout=$(pg_setting archive_timeout)
  IFS=$'\t' read -r count wal last_ts failed fwal fail_ts < <(psql_q "
    select archived_count, coalesce(last_archived_wal, '-'), coalesce(extract(epoch from last_archived_time)::bigint, 0),
           failed_count, coalesce(last_failed_wal, '-'), coalesce(extract(epoch from last_failed_time)::bigint, 0)
    from pg_stat_archiver")
  queued=$(find "$PG_DATA/pg_wal/archive_status" -name '*.ready' 2>/dev/null | wc -l)
  if ((failed)); then extra+=" · $failed failed since reset"; fi
  if ((queued > 2)); then extra+=" · $(meh "$queued WAL queued")"; fi
  if ((fail_ts > last_ts)); then
    row Archiving "$(bad FAILING) since $(fmt_ts "$fail_ts") ($fwal) · last ok: $(if ((last_ts)); then echo "$(ago "$last_ts") ago"; else echo never; fi)"
  elif ((last_ts)); then
    row Archiving "$(good ok) · last $(ago "$last_ts") ago ($wal) · $count archived · timeout ${timeout}s$extra"
  else
    row Archiving "$(meh "on, nothing archived yet") · timeout ${timeout}s"
  fi
}

status_backups() {
  if ((CONFIGURED == 0)); then
    row Backups "$(meh "not configured") · run: postgres-manager setup"
    return 0
  fi
  if ! command -v pgbackrest >/dev/null || ! command -v jq >/dev/null; then
    row Backups "$(bad "pgbackrest/jq missing") · run: postgres-manager setup"
    return 0
  fi
  local json code msg count last_full oldest_stop repo_total running last last_type age_txt
  json=$(pgbr_info_json)
  json=${json:-[]}
  code=$(jq -r '.[0].status.code // 99' <<<"$json" 2>/dev/null || echo 99)
  msg=$(jq -r '.[0].status.message // "repository not reachable"' <<<"$json" 2>/dev/null || echo "repository not reachable")
  count=$(jq -r '.[0].backup // [] | length' <<<"$json" 2>/dev/null || echo 0)
  if [[ $code != 0 ]] || ((count == 0)); then
    row Backups "$(bad "$msg") · $(repo_label)"
    row Schedule "$(schedule_line)"
    return 0
  fi
  IFS=$'\t' read -r last_full oldest_stop repo_total running last last_type < <(jq -r '.[0] | [
      ([.backup[] | select(.type == "full")] | last | .timestamp.stop // 0),
      .backup[0].timestamp.stop,
      ([.backup[].info.repository.delta] | add),
      (.status.lock.backup.held // false),
      (.backup | last | .timestamp.stop),
      (.backup | last | .type)
    ] | @tsv' <<<"$json")
  age_txt="last $last_type $(ago "$last") ago"
  if (($(date +%s) - last > 2 * 86400)); then age_txt=$(bad "$age_txt"); fi
  if [[ $last_type != full ]]; then age_txt+=" · last full $(ago "$last_full") ago"; fi
  if [[ $running == true ]]; then age_txt+=" · $(meh "backup running")"; fi
  row Backups "$(good ok) · $age_txt · $count sets · $(hb "$repo_total") in repo"
  row PITR "from $(fmt_ts "$oldest_stop") ($(ago "$oldest_stop")) until now · retention ${RETENTION_DAYS}d · $(repo_label)"
  row Schedule "$(schedule_line)"
}

status_users() {
  local name flags out="" n=0 line rows=()
  mapfile -t rows < <(roles_info)
  for line in "${rows[@]}"; do
    IFS=$'\t' read -r name flags _ <<<"$line"
    [[ -n $name ]] || continue
    n=$((n + 1))
    if ((n > 8)); then continue; fi
    flags=${flags//createdb/}
    flags=$(sed -E 's/(, )+/, /g; s/^, |, $//g' <<<"${flags#-}")
    out+="${out:+, }$name${flags:+ $(dim "($flags)")}"
  done
  if ((n > 8)); then out+=" … +$((n - 8))"; fi
  row Users "$out"
}

require_root() {
  [[ $EUID -eq 0 ]] || die "Run as root: sudo $SELF ${action:-}"
}

detect_os() {
  [[ -r /etc/os-release ]] || die "Unsupported OS (no /etc/os-release)"
  OS_ID=$(. /etc/os-release && echo "${ID:-}")
  OS_LIKE=$(. /etc/os-release && echo "${ID_LIKE:-}")
  OS_CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME:-}")
  OS_PRETTY=$(. /etc/os-release && echo "${PRETTY_NAME:-$ID}")
  if [[ $OS_ID != debian && $OS_ID != ubuntu ]]; then
    case $OS_LIKE in
      *ubuntu*) OS_ID=ubuntu ;;
      *debian*) OS_ID=debian ;;
      *) die "Unsupported OS: $OS_PRETTY (Debian/Ubuntu only)" ;;
    esac
  fi
}

APT_UPDATED=0
apt_update() {
  if ((APT_UPDATED == 0)); then
    info "apt-get update"
    DEBIAN_FRONTEND=noninteractive apt-get update -qq </dev/null
    APT_UPDATED=1
  fi
}

apt_install() {
  local missing=() pkg
  for pkg in "$@"; do
    if ! pkg_installed "$pkg"; then missing+=("$pkg"); fi
  done
  if ((${#missing[@]} == 0)); then return 0; fi
  apt_update
  info "Installing ${missing[*]}"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}" </dev/null >/dev/null 2>&1
}

pkg_installed() {
  [[ $(dpkg-query -W -f='${Status}' "$1" 2>/dev/null || true) == "install ok installed" ]]
}

pkg_available() {
  local cand
  cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
  [[ -n $cand && $cand != "(none)" ]]
}

has_pgdg_repo() {
  grep -rqs 'apt.postgresql.org' /etc/apt/sources.list /etc/apt/sources.list.d/
}

ensure_pgdg_repo() {
  if has_pgdg_repo; then return 0; fi
  warn "The official PostgreSQL apt repository (apt.postgresql.org) is not configured."
  if ! confirm "Add it? (recommended: current pgBackRest and extension packages)" Y; then return 1; fi
  apt_update
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends postgresql-common ca-certificates curl gnupg </dev/null >/dev/null 2>&1
  /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y </dev/null >/dev/null 2>&1
  APT_UPDATED=0
  apt_update
  ok "Added apt.postgresql.org"
}

ensure_timescale_repo() {
  if grep -rqs 'packagecloud.io/timescale' /etc/apt/sources.list /etc/apt/sources.list.d/; then return 0; fi
  apt_install curl gnupg ca-certificates
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor --yes -o /etc/apt/keyrings/timescaledb.gpg
  echo "deb [signed-by=/etc/apt/keyrings/timescaledb.gpg] https://packagecloud.io/timescale/timescaledb/$OS_ID/ $OS_CODENAME main" \
    >/etc/apt/sources.list.d/timescaledb.list
  APT_UPDATED=0
  apt_update
  ok "Added the TimescaleDB apt repository"
}

postgres_manager_menu_command() {

  backups_menu() {
    local pick="" type=""
    while :; do
      if ((CONFIGURED)); then
        header "Backups & restore · $(repo_label)"
        menu_items \
          1 "List backups" "backup sets, sizes and the point-in-time recovery window" \
          2 "Run backup now" "full = everything, diff = changes since the last full, incr = since the last backup" \
          3 "Restore / point in time" "into a separate directory (safe) or over this cluster, to any second in the window" \
          4 "Restore drill" "proves the backups work: restores the latest into a temp dir, starts it, compares, removes it" \
          5 "Check archiving" "pgBackRest check: WAL archiving and repository access" \
          6 "Settings" "schedule, retention, RPO, performance, repository, heartbeat, passphrase" \
          7 "Re-run setup" "reconfigure pgBackRest and WAL archiving from scratch" \
          b "Back" ""
      else
        header "Backups & restore · not configured"
        menu_items \
          1 "Set up backups" "pgBackRest + continuous WAL archiving to Cloudflare R2, S3 or a local directory" \
          b "Back" ""
      fi
      menu_choice pick || return 0
      if ((CONFIGURED == 0)) && [[ $pick == 1 ]]; then pick=7; fi
      case $pick in
        1) run_cmd list ;;
        2)
          ask type "Type (full/diff/incr)" diff
          run_cmd backup "$type"
          ;;
        3) run_cmd restore ;;
        4) run_cmd verify ;;
        5) run_cmd check ;;
        6) run_cmd edit ;;
        7) run_cmd setup ;;
        b | B | q | Q | '') return 0 ;;
        *) warn "Unknown choice" ;;
      esac
      CONFIGURED=0
      load_config
    done
  }

  show_status
  choice=""
  while :; do
    header "PostgreSQL $PG_VERSION/$PG_CLUSTER"
    menu_items \
      1 "Databases" "list, create and drop databases" \
      2 "Users & access" "create users, read-only access, passwords, drop users" \
      3 "Extensions" "PostGIS, pgvector, TimescaleDB, pg_cron, pg_stat_statements" \
      4 "Backups & restore" "pgBackRest backups, point-in-time restore, restore drill" \
      s "Status" "refresh the dashboard" \
      q "Quit" ""
    menu_choice choice || break
    case $choice in
      1) run_cmd db ;;
      2) run_cmd user ;;
      3) run_cmd extensions ;;
      4) backups_menu ;;
      s | S) run_cmd status ;;
      q | Q | b | B | '') break ;;
      *) warn "Unknown choice" ;;
    esac
  done

}

