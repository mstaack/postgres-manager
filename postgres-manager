normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

env_files() {
  find /home /var/www -mindepth 2 -maxdepth 3 -name .env -type f 2>/dev/null | sort || true
}

env_get() {
  sed -nE "s/^[[:space:]]*(export[[:space:]]+)?$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null | tail -n1 |
    sed -E 's/[[:space:]]+#.*$//; s/^"(.*)"$/\1/; s/^'\''(.*)'\''$/\1/'
}

scan_apps() {
  local f
  while IFS= read -r f; do
    [[ -n $f && $(env_get "$f" DB_CONNECTION) == pgsql ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s:%s\n' "$(dirname "$f")" "$(env_get "$f" APP_NAME)" "$(env_get "$f" APP_ENV)" \
      "$(env_get "$f" DB_DATABASE)" "$(env_get "$f" DB_USERNAME)" "$(env_get "$f" DB_HOST)" "$(env_get "$f" DB_PORT)"
  done < <(env_files)
}

app_databases() {
  local db out=""
  while IFS= read -r db; do
    if [[ -n $db ]] && database_exists "$db"; then out+="${out:+ }$db"; fi
  done < <(scan_apps | cut -f4 | sort -u)
  printf '%s' "$out"
}

detect_r2_account() {
  local f
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    grep -hoE '[0-9a-f]{32}\.((eu|fedramp)\.)?r2\.cloudflarestorage\.com' "$f" 2>/dev/null | head -n1 | cut -d. -f1
  done < <(env_files) | head -n1
}

config_defaults() {
  local cpus
  cpus=$(nproc 2>/dev/null || echo 2)
  : "${PG_VERSION:=}" "${PG_CLUSTER:=}" "${STANZA:=}"
  : "${REPO_TYPE:=r2}" "${R2_ACCOUNT_ID:=}" "${R2_JURISDICTION:=default}"
  : "${S3_ENDPOINT:=}" "${S3_REGION:=auto}" "${S3_BUCKET:=}" "${S3_KEY:=}" "${S3_SECRET:=}" "${S3_URI_STYLE:=path}"
  : "${REPO_PATH:=}" "${CIPHER_PASS:=}"
  : "${RETENTION_DAYS:=30}" "${ARCHIVE_TIMEOUT:=60}" "${ARCHIVE_QUEUE_MAX:=8GB}"
  : "${PROCESS_MAX:=$(((cpus / 4) < 1 ? 1 : ((cpus / 4) > 4 ? 4 : cpus / 4)))}" "${COMPRESS_LEVEL:=3}"
  : "${HEARTBEAT_URL:=}"
  if [[ -z ${FULL_SCHEDULE+x} ]]; then FULL_SCHEDULE="30 1 * * 0"; fi
  if [[ -z ${DIFF_SCHEDULE+x} ]]; then DIFF_SCHEDULE="30 1 * * 1-6"; fi
  if [[ -z ${INCR_SCHEDULE+x} ]]; then INCR_SCHEDULE=""; fi
}

CONFIGURED=0
load_config() {
  if [[ -f $CONF_FILE ]]; then
    # shellcheck disable=SC1090
    source "$CONF_FILE"
    CONFIGURED=1
  fi
  config_defaults
}

save_config() {
  local tmp k
  install -d -m 0700 "$CONF_DIR"
  tmp=$(mktemp "$CONF_DIR/.backup.conf.XXXXXX")
  {
    echo "# postgres-manager settings — change via: postgres-manager edit"
    for k in "${CONFIG_KEYS[@]}"; do printf '%s=%q\n' "$k" "${!k}"; done
  } >"$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$CONF_FILE"
  CONFIGURED=1
}

