  require_pg
  name=${args[name]-}
  from_stdin=${args[--password-stdin]-}
  yes=${args[--yes]-}
  interactive=0
  if [[ -z $name ]]; then
    interactive=1
    header "Change password"
    pick_role name "User"
  fi
  role_exists "$name" || die "User $name does not exist"
  apps=$(apps_using 5 "$name")
  if [[ -n $apps ]]; then
    warn "$name is used by app: $apps — update DB_PASSWORD in its .env (and re-cache the config) right after."
    if [[ -z $yes ]] && ! confirm "Change the password anyway?" N; then die "Aborted"; fi
  fi
  password=""
  get_password password "$from_stdin" "$interactive"
  set_password "$name" "$password"
  ok "Password of $name changed"
  if ((PW_SHOW)); then show_credentials "$name" "$password" "$(role_database "$name")" 1; fi

}

postgres_manager_user_grant_command() {

  require_pg
  name=${args[name]-}
  databases=${args[databases]-}
  if [[ -z $name ]]; then
    header "Grant read-only access"
    pick_role name "User" nopostgres
  fi
  role_exists "$name" || die "User $name does not exist"
  if [[ -n $(psql_q "select 1 from pg_roles where rolsuper and rolname = $(sql_lit "$name")") ]]; then
    die "$name is a superuser and can read everything already"
  fi
  if [[ -z $databases ]]; then ask_databases databases "Read-only on" "$(app_databases)"; fi
  parse_databases "$databases"
  for db in $DBS; do grant_read_only "$name" "$db"; done
  info "Tables created later by other roles than the current owners: run this again."

}

postgres_manager_user_revoke_command() {

  require_pg
  name=${args[name]-}
  databases=${args[databases]-}
  if [[ -z $name ]]; then
    header "Revoke read-only access"
    pick_role name "User" nopostgres
  fi
  role_exists "$name" || die "User $name does not exist"
  if [[ -z $databases ]]; then
    current=""
    IFS=$'\t' read -r _ _ _ current _ < <(roles_info | awk -F'\t' -v r="$name" '$1 == r')
    if [[ $current == "all databases"* ]]; then current="all${current#all databases}"; fi
    if [[ $current == - ]]; then current=""; fi
    info "$name reads: ${current:-nothing}"
    ask_databases databases "Revoke on" "$current"
  fi
  parse_databases "$databases"
  for db in $DBS; do revoke_read_only "$name" "$db"; done

}

postgres_manager_user_drop_command() {

  require_pg
  name=${args[name]-}
  yes=${args[--yes]-}
  if [[ -z $name ]]; then
    header "Drop user"
    pick_role name "User to drop" nopostgres
  fi
  [[ $name != postgres ]] || die "Refusing to drop postgres"
  role_exists "$name" || die "User $name does not exist"
  owned=$(psql_q "select string_agg(datname, ', ') from pg_database where datdba = (select oid from pg_roles where rolname = $(sql_lit "$name"))")
  [[ -z $owned ]] || die "$name owns $owned — drop those databases first (postgres-manager db drop)"
  apps=$(apps_using 5 "$name")
  warn "Drop user $name (its sessions are terminated; objects it owns in other databases go to postgres)"
  if [[ -n $apps ]]; then warn "Used by app: $apps"; fi
  if [[ -z $yes ]]; then
    typed=""
    ask typed "Type '$name' to drop it"
    [[ $typed == "$name" ]] || die "Aborted"
  fi
  drop_role "$name"
  ok "Dropped user $name"

}

postgres_manager_extensions_command() {

  require_pg
  preload=$(pg_setting shared_preload_libraries)

  header "Extensions · PostgreSQL $PG_VERSION/$PG_CLUSTER"
  i=1
  for key in "${EXTENSIONS[@]}"; do
    printf '  %s%d)%s %-52s %s\n' "$B" "$i" "$N" "$(ext_label "$key")" "$(ext_state "$key" "$preload")"
    i=$((i + 1))
  done
  ask selection "Install/enable which (e.g. \"1 3\", empty = cancel)" ""
  [[ -n $selection ]] || exit 0
  chosen=()
  for n in $selection; do
    [[ $n =~ ^[1-5]$ ]] || die "Invalid choice: $n"
    chosen+=("${EXTENSIONS[n - 1]}")
  done

  header "Packages"
  for key in "${chosen[@]}"; do ensure_ext_package "$key"; done
  ok "Packages ready"

  new_preload=$preload
  restart=0
  for key in "${chosen[@]}"; do
    if ext_needs_preload "$key" && ! preload_has "$new_preload" "$key"; then
      new_preload="${new_preload:+$new_preload,}$key"
      restart=1
    fi
  done
  default_dbs=$(app_databases)
  cron_db=$(pg_setting cron.database_name)
  if [[ " ${chosen[*]} " == *" pg_cron "* ]]; then
    cron_db_new=""
    ask cron_db_new "Database for pg_cron jobs (cron.database_name)" "${cron_db:-${default_dbs%% *}}"
    if [[ $cron_db_new != "$cron_db" ]]; then restart=1; fi
    cron_db=$cron_db_new
  fi
  if ((restart)); then
    write_pg_snippet "$PG_SNIPPET_EXTENSIONS" "# Managed by postgres-manager — extension settings.
  shared_preload_libraries = '$new_preload'${cron_db:+
  cron.database_name = '$cron_db'}"
    warn "shared_preload_libraries changed ($new_preload) — needs a PostgreSQL restart."
    if confirm "Restart PostgreSQL $PG_VERSION/$PG_CLUSTER now?" Y; then
      pg_restart
    else
      warn "Restart later, then run extensions again to CREATE EXTENSION the preloaded ones."
    fi
  fi

  header "Enable in databases"
  info "Databases: $(list_databases | tr '\n' ' ')"
  ask targets "CREATE EXTENSION in which databases (space-separated, 'all', '-' = skip)" "${default_dbs:--}"
  case $targets in
    -) targets="" ;;
    all) targets=$(list_databases | grep -vx postgres | tr '\n' ' ') ;;
  esac
  preload=$(pg_setting shared_preload_libraries)
  for key in "${chosen[@]}"; do
    sql=$(ext_sql_name "$key")
    if ext_needs_preload "$key" && ! preload_has "$preload" "$key"; then
      warn "$key is not preloaded yet (restart pending) — skipped"
      continue
    fi
    key_targets=$targets
    if [[ $key == pg_cron ]]; then key_targets=$(pg_setting cron.database_name); fi
    for db in $key_targets; do
      if ! database_exists "$db"; then
        warn "Database $db does not exist — skipped"
      elif psql_q "create extension if not exists \"$sql\"" "$db" >/dev/null 2>&1; then
        ok "$sql enabled in $db"
      else
        warn "Could not create $sql in $db"
      fi
    done
  done

}

postgres_manager_setup_command() {

  header "Backup setup · PostgreSQL $PG_VERSION/$PG_CLUSTER · $PG_DATA"
  pg_ready || die "PostgreSQL $PG_VERSION/$PG_CLUSTER must be running"
  if ((CONFIGURED)); then
    warn "Backups are already configured ($(repo_label)). Re-running setup keeps unchanged values."
    confirm "Continue?" Y || exit 0
  fi

  header "Packages"
  if ! has_pgdg_repo || ! pkg_available pgbackrest; then ensure_pgdg_repo || true; fi
  apt_install pgbackrest jq curl cron ca-certificates
  pgbackrest_version=$(pgbr_version)
  ok "pgBackRest $pgbackrest_version"
  if ! version_ge "$pgbackrest_version" "$PGBR_MIN_BLOCK_VERSION"; then
    warn "pgBackRest < $PGBR_MIN_BLOCK_VERSION: no block incremental backups (add apt.postgresql.org for a current version)"
  fi

  ask STANZA "Stanza name" "${STANZA:-$PG_CLUSTER}"
  prompt_repository
  prompt_cipher

  header "Schedule & retention"
  row Schedule "$(schedule_line)"
  row Retention "${RETENTION_DAYS} days"
  row RPO "archive_timeout ${ARCHIVE_TIMEOUT}s"
  row Parallel "$PROCESS_MAX processes · zstd level $COMPRESS_LEVEL"
  if ! confirm "Use these settings?" Y; then
    edit_schedule
    edit_retention
    edit_rpo
    edit_performance
  fi
  edit_heartbeat

  save_config
  render_pgbackrest_conf
  ok "Wrote $CONF_FILE and $PGBR_CONF"

  header "Repository"
  info "Testing repository access"
  repo_reachable || die "Cannot access the repository — check endpoint, bucket and keys (postgres-manager edit)"
  ok "Repository reachable"
  pgbr --log-level-console=warn stanza-create
  ok "Stanza $STANZA ready"

  header "WAL archiving"
  write_archive_snippet
  if ((ARCHIVE_NEEDS_RESTART)); then
    warn "archive_mode/wal_level changes need a PostgreSQL restart (a few seconds of downtime)."
    if confirm "Restart PostgreSQL $PG_VERSION/$PG_CLUSTER now?" Y; then
      pg_restart
    else
      warn "Archiving starts after the next restart — then run: postgres-manager check"
    fi
  fi
  if [[ $(pg_setting archive_mode) == on ]]; then
    pgbr --log-level-console=warn check
    ok "WAL archiving works"
  fi

  install_self
  write_cron
  ok "Cron: $(schedule_line)"

  if [[ $(pg_setting archive_mode) == on ]] && confirm "Run the first full backup now?" Y; then
    run_backup full
  fi
  header "Done"
  status_archiving
  status_backups

}

postgres_manager_edit_command() {

  require_configured
  repo_changed=0
  old_archive_timeout=$ARCHIVE_TIMEOUT
  while :; do
    header "Backup settings"
    choose pick "Change" 9 \
      "Schedule            $(schedule_line)" \
      "Retention           ${RETENTION_DAYS} days" \
      "RPO                 archive_timeout ${ARCHIVE_TIMEOUT}s" \
      "Performance         $PROCESS_MAX processes, zstd $COMPRESS_LEVEL" \
      "WAL queue limit     $ARCHIVE_QUEUE_MAX" \
      "Heartbeat URL       ${HEARTBEAT_URL:-off}" \
      "Repository          $(repo_label)" \
      "Show encryption passphrase" \
      "Save & apply"
    case $pick in
      1) edit_schedule ;;
      2) edit_retention ;;
      3) edit_rpo ;;
      4) edit_performance ;;
      5) edit_queue ;;
      6) edit_heartbeat ;;
      7)
        warn "A new repository starts empty: a new full backup is taken after saving."
        prompt_repository
        repo_changed=1
        ;;
      8) printf '\n    %s%s%s\n' "$B" "$CIPHER_PASS" "$N" ;;
      9) break ;;
    esac
  done

  apply_config
  if [[ $ARCHIVE_TIMEOUT != "$old_archive_timeout" ]]; then write_archive_snippet; fi
  ok "Saved and applied"

  if ((repo_changed)); then
    repo_reachable || die "Cannot access the new repository"
    pgbr --log-level-console=warn stanza-create
    pgbr --log-level-console=warn check
    run_backup full
  fi

}

postgres_manager_list_command() {

  require_configured
  json=$(pgbr_info_json)
  [[ -n $json ]] || die "pgbackrest info failed — run: postgres-manager check"
  header "Backups · stanza $STANZA · $(repo_label)"
  if [[ $(jq -r '.[0].status.code' <<<"$json") != 0 ]]; then
    warn "$(jq -r '.[0].status.message' <<<"$json")"
    exit 0
  fi

  printf '  %s%-34s %-5s %-17s %9s %10s %10s%s\n' "$D" LABEL TYPE STARTED DURATION SIZE REPO "$N"
  while IFS=$'\t' read -r label type start stop size delta; do
    printf '  %-34s %-5s %-17s %9s %10s %10s\n' "$label" "$type" "$(fmt_ts "$start")" \
      "$(duration $((stop - start)))" "$(hb "$size")" "$(hb "$delta")"
  done < <(jq -r '.[0].backup[] | [.label, .type, .timestamp.start, .timestamp.stop, .info.size, .info.repository.delta] | @tsv' <<<"$json")

  IFS=$'\t' read -r oldest wal_min wal_max total < <(jq -r '.[0] | [.backup[0].timestamp.stop, (.archive[-1].min // "-"),
    (.archive[-1].max // "-"), ([.backup[].info.repository.delta] | add)] | @tsv' <<<"$json")
  echo
  row PITR "any point from $(fmt_ts "$oldest") until the last archived WAL"
  row WAL "$wal_min … $wal_max"
  row Repo "$(hb "$total") (backups, excl. WAL)"

}

