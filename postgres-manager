}
header() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
row() { printf '  %s%-11s%s %s\n' "$D" "$1" "$N" "$2"; }
good() { printf '%s%s%s' "$G" "$*" "$N"; }
bad() { printf '%s%s%s' "$R" "$*" "$N"; }
meh() { printf '%s%s%s' "$Y" "$*" "$N"; }
