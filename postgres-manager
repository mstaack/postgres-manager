  declare -gr CONF_DIR="/etc/postgres-manager"
  declare -gr CONF_FILE="$CONF_DIR/backup.conf"
  declare -gr PGBR_CONF_DIR="/etc/pgbackrest"
  declare -gr PGBR_CONF="$PGBR_CONF_DIR/pgbackrest.conf"
  declare -gr PGBR_LOG_DIR="/var/log/pgbackrest"
  declare -gr PGBR_SPOOL_DIR="/var/spool/pgbackrest"
  declare -gr PGBR_MIN_BLOCK_VERSION="2.46"
  declare -gr CRON_FILE="/etc/cron.d/postgres-manager"
  declare -gr LOCK_FILE="/run/postgres-manager-backup.lock"
  declare -gr PG_SNIPPET_ARCHIVE="90-postgres-manager-archive.conf"
  declare -gr PG_SNIPPET_EXTENSIONS="91-postgres-manager-extensions.conf"
  declare -gr VERIFY_PORT=54329
  declare -gr RESTORE_PORT=54330

  SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
  declare -gr SELF

  declare -ga CONFIG_KEYS=(PG_VERSION PG_CLUSTER STANZA REPO_TYPE R2_ACCOUNT_ID R2_JURISDICTION S3_ENDPOINT
    S3_REGION S3_BUCKET S3_KEY S3_SECRET S3_URI_STYLE REPO_PATH CIPHER_PASS RETENTION_DAYS ARCHIVE_TIMEOUT
    ARCHIVE_QUEUE_MAX PROCESS_MAX COMPRESS_LEVEL FULL_SCHEDULE DIFF_SCHEDULE INCR_SCHEDULE HEARTBEAT_URL)

  declare -ga EXTENSIONS=(postgis pgvector timescaledb pg_cron pg_stat_statements)

  if [[ -t 1 ]]; then
    B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m'
  else
    B='' D='' R='' G='' Y='' C='' N=''
  fi

  trap 'printf "%s✗ failed (line %s): %s%s\n" "$R" "$LINENO" "$BASH_COMMAND" "$N" >&2' ERR
  cd /

  # No arguments → dashboard + menu (bashly's default command only catches unknown commands)
  if ((${#command_line_args[@]} == 0)); then
    command_line_args=(menu)
  fi

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "menu") postgres_manager_menu_command ;;
    "status") postgres_manager_status_command ;;
    "db") postgres_manager_db_command ;;
    "db menu") postgres_manager_db_menu_command ;;
    "db list") postgres_manager_db_list_command ;;
    "db create") postgres_manager_db_create_command ;;
    "db drop") postgres_manager_db_drop_command ;;
    "user") postgres_manager_user_command ;;
    "user menu") postgres_manager_user_menu_command ;;
    "user list") postgres_manager_user_list_command ;;
    "user create") postgres_manager_user_create_command ;;
    "user password") postgres_manager_user_password_command ;;
    "user grant") postgres_manager_user_grant_command ;;
    "user revoke") postgres_manager_user_revoke_command ;;
    "user drop") postgres_manager_user_drop_command ;;
    "extensions") postgres_manager_extensions_command ;;
    "setup") postgres_manager_setup_command ;;
    "edit") postgres_manager_edit_command ;;
    "list") postgres_manager_list_command ;;
    "backup") postgres_manager_backup_command ;;
    "check") postgres_manager_check_command ;;
    "verify") postgres_manager_verify_command ;;
    "restore") postgres_manager_restore_command ;;
    "self-update") postgres_manager_self_update_command ;;
    "cron-backup") postgres_manager_cron_backup_command ;;
  esac
}

start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
