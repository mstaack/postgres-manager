render_pgbackrest_conf() {
  local tmp pgbr_ver
  pgbr_ver=$(pgbr_version)
  install -d -m 0750 -o root -g postgres "$PGBR_CONF_DIR"
  install -d -m 0750 -o postgres -g postgres "$PGBR_LOG_DIR" "$PGBR_SPOOL_DIR"
  if [[ $REPO_TYPE == posix ]]; then install -d -m 0750 -o postgres -g postgres "$REPO_PATH"; fi
  tmp=$(mktemp)
  {
    echo "# Managed by postgres-manager — change via: postgres-manager edit (manual edits are overwritten)"
    echo "[global]"
    case $REPO_TYPE in
      r2 | s3)
        printf '%s\n' "repo1-type=s3" "repo1-s3-endpoint=$S3_ENDPOINT" "repo1-s3-region=$S3_REGION" \
          "repo1-s3-bucket=$S3_BUCKET" "repo1-s3-key=$S3_KEY" "repo1-s3-key-secret=$S3_SECRET" \
          "repo1-s3-uri-style=$S3_URI_STYLE" "repo1-path=$REPO_PATH"
        ;;
      posix) printf '%s\n' "repo1-type=posix" "repo1-path=$REPO_PATH" ;;
    esac
    printf '%s\n' "repo1-cipher-type=aes-256-cbc" "repo1-cipher-pass=$CIPHER_PASS" \
      "repo1-retention-full-type=time" "repo1-retention-full=$RETENTION_DAYS"
    if [[ -n $pgbr_ver ]] && version_ge "$pgbr_ver" "$PGBR_MIN_BLOCK_VERSION"; then
      printf '%s\n' "repo1-bundle=y" "repo1-block=y"
    fi
    printf '%s\n' "compress-type=zst" "compress-level=$COMPRESS_LEVEL" "process-max=$PROCESS_MAX" \
      "start-fast=y" "delta=y" "archive-async=y" "archive-push-queue-max=$ARCHIVE_QUEUE_MAX" \
      "spool-path=$PGBR_SPOOL_DIR" "log-path=$PGBR_LOG_DIR" "log-level-file=info"
    echo
    echo "[$STANZA]"
    printf '%s\n' "pg1-path=$PG_DATA" "pg1-port=$PG_PORT" "pg1-socket-path=$(pg_socket_dir)"
  } >"$tmp"
  install -m 0640 -o root -g postgres "$tmp" "$PGBR_CONF"
  rm -f "$tmp"
}

ARCHIVE_NEEDS_RESTART=0
write_archive_snippet() {
  local wal_level archive_mode extra=""
  wal_level=$(pg_setting wal_level)
  archive_mode=$(pg_setting archive_mode)
  if [[ $wal_level == minimal ]]; then extra=$'\nwal_level = replica'; fi
  write_pg_snippet "$PG_SNIPPET_ARCHIVE" "# Managed by postgres-manager — WAL archiving to pgBackRest (point-in-time recovery).
# Change via: postgres-manager edit
archive_mode = on
archive_command = 'pgbackrest --stanza=$STANZA archive-push %p'
archive_timeout = ${ARCHIVE_TIMEOUT}s$extra"
  ARCHIVE_NEEDS_RESTART=0
  if [[ $archive_mode != on || $wal_level == minimal ]]; then ARCHIVE_NEEDS_RESTART=1; fi
}

write_cron() {
  local cmd="$INSTALL_PATH cron-backup" type var
  {
    echo "# Managed by postgres-manager — change via: postgres-manager edit"
    echo "SHELL=/bin/bash"
    echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    for type in full diff incr; do
      var="${type^^}_SCHEDULE"
      if [[ -n ${!var} ]]; then echo "${!var} root $cmd $type 2>&1 | logger -t postgres-manager"; fi
    done
  } >"$CRON_FILE"
  chmod 0644 "$CRON_FILE"
}

install_self() {
  if [[ -f $SELF && $SELF != "$INSTALL_PATH" ]]; then
    install -m 0755 "$SELF" "$INSTALL_PATH"
    ok "Installed $INSTALL_PATH"
  elif [[ ! -x $INSTALL_PATH ]]; then
    warn "Could not install myself to $INSTALL_PATH (cron needs it) — copy this script there manually"
  fi
}

heartbeat() {
  if [[ -n $HEARTBEAT_URL ]]; then
    curl -fsS -m 10 --retry 3 -o /dev/null "${HEARTBEAT_URL%/}$1" || warn "Heartbeat ping failed"
  fi
}

backup_lock() {
  exec 9>"$LOCK_FILE"
  if [[ $1 == try ]]; then
    flock -n 9
  else
    flock -w 14400 9
  fi
}

backup_unlock() {
  flock -u 9 || true
  exec 9>&-
}

run_backup() {
  local type=$1
  backup_lock wait || die "Another backup is still running"
  info "Running $type backup (stanza $STANZA → $(repo_label))"
  pgbr --type="$type" --log-level-console=info backup
  backup_unlock
  ok "$type backup finished"
}

as_postgres() { runuser -u postgres -- "$@"; }

psql_q() {
  as_postgres psql -XAtq -v ON_ERROR_STOP=1 -p "$PG_PORT" -d "${2:-postgres}" -F $'\t' -c "$1"
}

pg_ready() {
  as_postgres "$PG_BIN/pg_isready" -q -p "$PG_PORT" >/dev/null 2>&1
}

wait_ready() {
  local timeout=${1:-120} i
  for ((i = 0; i < timeout; i++)); do
    if pg_ready; then return 0; fi
    sleep 1
  done
  die "PostgreSQL did not become ready within ${timeout}s"
}

detect_cluster() {
  command -v pg_lsclusters >/dev/null || die "pg_lsclusters not found — is PostgreSQL (postgresql-common) installed?"
  local rows=() labels=() r sel="" pick v c p s
  mapfile -t rows < <(pg_lsclusters -h 2>/dev/null | awk '{print $1" "$2" "$3" "$4" "$6}')
  ((${#rows[@]})) || die "No PostgreSQL cluster found (pg_lsclusters is empty)"
  if [[ -n $PG_VERSION && -n $PG_CLUSTER ]]; then
    for r in "${rows[@]}"; do
      if [[ $r == "$PG_VERSION $PG_CLUSTER "* ]]; then sel=$r; fi
    done
    if [[ -z $sel ]]; then warn "Configured cluster $PG_VERSION/$PG_CLUSTER not found"; fi
  fi
  if [[ -z $sel ]]; then
    if ((${#rows[@]} == 1)); then
      sel=${rows[0]}
    else
      header "Multiple PostgreSQL clusters"
      for r in "${rows[@]}"; do
        read -r v c p s _ <<<"$r"
        labels+=("$v/$c (port $p, $s)")
      done
      choose pick "Cluster to manage" 1 "${labels[@]}"
      sel=${rows[pick - 1]}
    fi
  fi
  read -r PG_VERSION PG_CLUSTER PG_PORT PG_STATUS PG_DATA <<<"$sel"
  PG_BIN="/usr/lib/postgresql/$PG_VERSION/bin"
  PG_ETC="/etc/postgresql/$PG_VERSION/$PG_CLUSTER"
  PG_SHARE="/usr/share/postgresql/$PG_VERSION"
}

pg_restart() {
  info "Restarting PostgreSQL $PG_VERSION/$PG_CLUSTER"
  # fd 9 is the backup lock; the postmaster must not inherit it
  pg_ctlcluster "$PG_VERSION" "$PG_CLUSTER" restart 9>&-
  wait_ready 300
  ok "PostgreSQL restarted"
}

pg_reload() {
  psql_q "select pg_reload_conf()" >/dev/null
}

pg_setting() {
  psql_q "select setting from pg_settings where name = '$1'" 2>/dev/null || true
}

pg_socket_dir() {
  local dirs
  dirs=$(pg_setting unix_socket_directories)
  dirs=${dirs%%,*}
  printf '%s' "${dirs:-/var/run/postgresql}"
}

list_databases() {
  psql_q "select datname from pg_database where datallowconn and not datistemplate order by datname"
}

database_exists() {
  list_databases | grep -x "$1" >/dev/null
}

ensure_conf_d() {
  local conf="$PG_ETC/postgresql.conf"
  [[ -f $conf ]] || die "$conf not found"
  if ! grep -Eq "^[[:space:]]*include_dir[[:space:]]*=[[:space:]]*'conf\.d'" "$conf"; then
    info "Adding include_dir = 'conf.d' to $conf"
    printf "\n# Added by postgres-manager\ninclude_dir = 'conf.d'\n" >>"$conf"
  fi
  install -d -o postgres -g postgres -m 0755 "$PG_ETC/conf.d"
}

write_pg_snippet() {
  local file=$1 content=$2
  ensure_conf_d
  printf '%s\n' "$content" >"$PG_ETC/conf.d/$file"
  chown postgres:postgres "$PG_ETC/conf.d/$file"
  pg_reload
  check_overrides "$file"
}

check_overrides() {
  local snippet=$1 name src names=()
  mapfile -t names < <(psql_q "select distinct name from pg_file_settings where sourcefile like '%/$snippet' and not applied and error is null")
  for name in "${names[@]}"; do
    [[ -n $name ]] || continue
    src=$(psql_q "select sourcefile from pg_file_settings where name = '$name' order by seqno desc limit 1")
    if [[ $src == */postgresql.auto.conf ]]; then
      warn "$name is overridden by ALTER SYSTEM ($src)"
      if confirm "Run ALTER SYSTEM RESET $name so $snippet applies?" Y; then
        psql_q "alter system reset $name" >/dev/null
        pg_reload
      fi
    else
      warn "$name in $snippet is overridden by $src — remove it there"
    fi
  done
}

read_line() {
  IFS= read -r "$1" || die "No input (stdin closed)"
}

ask() {
  local __ask_var=$1 __ask_prompt=$2 __ask_def=${3-} __ask_reply
  if [[ -n $__ask_def ]]; then
    printf '%s %s[%s]%s: ' "$__ask_prompt" "$D" "$__ask_def" "$N"
  else
    printf '%s: ' "$__ask_prompt"
  fi
  read_line __ask_reply
  printf -v "$__ask_var" '%s' "${__ask_reply:-$__ask_def}"
}

ask_secret() {
  local __sec_var=$1 __sec_prompt=$2 __sec_cur=${3-} __sec_reply __sec_hint=""
  if [[ -n $__sec_cur ]]; then __sec_hint=" ${D}[keep current]${N}"; fi
  printf '%s%s: ' "$__sec_prompt" "$__sec_hint"
  IFS= read -rs __sec_reply || die "No input (stdin closed)"
  printf '\n'
  printf -v "$__sec_var" '%s' "${__sec_reply:-$__sec_cur}"
}

confirm() {
  local __cf_def=${2:-N} __cf_reply __cf_opts="y/N"
  if [[ $__cf_def == Y ]]; then __cf_opts="Y/n"; fi
  printf '%s %s[%s]%s: ' "$1" "$D" "$__cf_opts" "$N"
  read_line __cf_reply
  __cf_reply=${__cf_reply:-$__cf_def}
  [[ $__cf_reply =~ ^[Yy] ]]
}

choose() {
  local __ch_var=$1 __ch_prompt=$2 __ch_def=$3 __ch_i=1 __ch_opt __ch_reply
  shift 3
  for __ch_opt in "$@"; do
    printf '  %s%d)%s %s\n' "$B" "$__ch_i" "$N" "$__ch_opt"
    __ch_i=$((__ch_i + 1))
  done
  while :; do
    ask __ch_reply "$__ch_prompt" "$__ch_def"
    if [[ $__ch_reply =~ ^[0-9]+$ ]] && ((__ch_reply >= 1 && __ch_reply <= $#)); then break; fi
    warn "Pick 1-$#"
  done
  printf -v "$__ch_var" '%s' "$__ch_reply"
}

ask_int() {
  local __int_var=$1 __int_prompt=$2 __int_def=$3 __int_min=${4:-0} __int_max=${5:-999999} __int_reply
  while :; do
    ask __int_reply "$__int_prompt" "$__int_def"
    if [[ $__int_reply =~ ^[0-9]+$ ]] && ((__int_reply >= __int_min && __int_reply <= __int_max)); then break; fi
    warn "Enter a number between $__int_min and $__int_max"
  done
  printf -v "$__int_var" '%s' "$__int_reply"
}

restore_into_dir() {
  local dir=$1
  shift
  if [[ -d $dir && -n $(ls -A "$dir" 2>/dev/null) ]]; then die "$dir is not empty"; fi
  install -d -o postgres -g postgres -m 0700 "$dir"
  info "Restoring into $dir"
  pgbr --pg1-path="$dir" --archive-mode=off --log-level-console=info "$@" restore
}

write_standalone_conf() {
  local dir=$1 port=$2 preload
  preload=$(pg_setting shared_preload_libraries)
  if [[ -f $dir/postgresql.conf ]]; then mv "$dir/postgresql.conf" "$dir/postgresql.conf.orig"; fi
  {
    echo "# Written by postgres-manager for a restored copy — not the live cluster."
    echo "listen_addresses = ''"
    echo "port = $port"
    echo "unix_socket_directories = '$dir'"
    echo "shared_buffers = 256MB"
    # recovery requires these to be >= the values on the source cluster
    echo "max_connections = $(pg_setting max_connections)"
    echo "max_worker_processes = $(pg_setting max_worker_processes)"
    echo "max_locks_per_transaction = $(pg_setting max_locks_per_transaction)"
    echo "max_prepared_transactions = $(pg_setting max_prepared_transactions)"
    echo "max_wal_senders = $(pg_setting max_wal_senders)"
    echo "shared_preload_libraries = '$preload'"
    echo "archive_mode = off"
    echo "hot_standby = off"
    echo "logging_collector = off"
    if [[ $preload == *timescaledb* ]]; then echo "timescaledb.max_background_workers = 0"; fi
    if [[ $preload == *pg_cron* ]]; then echo "cron.database_name = '$(pg_setting cron.database_name)'"; fi
  } >"$dir/postgresql.conf"
  echo "local all all peer" >"$dir/pg_hba.conf"
  : >"$dir/pg_ident.conf"
  chown postgres:postgres "$dir/postgresql.conf" "$dir/pg_hba.conf" "$dir/pg_ident.conf"
}

start_standalone() {
  local dir=$1 port=$2 waited=0
  info "Starting restored copy (port $port, socket in $dir) — replays WAL, may take a while"
  as_postgres "$PG_BIN/pg_ctl" -D "$dir" -l "$dir/postgres-manager.log" -W -s start
  until as_postgres "$PG_BIN/pg_isready" -q -h "$dir" -p "$port" >/dev/null 2>&1; do
    if ((waited > 2)) && [[ ! -f $dir/postmaster.pid ]]; then
      tail -n 30 "$dir/postgres-manager.log" >&2 || true
      die "Restored copy stopped during recovery (log: $dir/postgres-manager.log)"
    fi
    sleep 2
    waited=$((waited + 2))
    if ((waited % 60 == 0)); then info "still recovering ($(duration "$waited"))"; fi
  done
}

stop_standalone() {
  as_postgres "$PG_BIN/pg_ctl" -D "$1" -m fast -w -s stop >/dev/null 2>&1 || true
}

standalone_psql() {
  as_postgres psql -XAtq -h "$1" -p "$2" -d "$3" -c "$4" 2>/dev/null
}

disk_check() {
  local dir=$1 need=$2 avail
  avail=$(df -B1 --output=avail "$dir" | tail -n1 | tr -d ' ')
  if ((need * 11 / 10 > avail)); then
    die "Not enough space in $dir: need ~$(hb "$need"), $(hb "$avail") free"
  fi
}

recovered_until() {
  local log=$1 line
  line=$(grep -oE 'last completed transaction was at log time .*' "$log" | tail -n1 | sed 's/.*log time //' || true)
  if [[ -z $line ]]; then
    line=$(grep -oE '(recovery stopping .*|redo done at [0-9A-F/]+)' "$log" | tail -n1 || true)
  fi
  printf '%s' "${line:-unknown}"
}

prompt_repository() {
  local pick def=1
  header "Backup repository"
  case $REPO_TYPE in s3) def=2 ;; posix) def=3 ;; esac
  choose pick "Repository type" "$def" "Cloudflare R2" "Other S3-compatible (AWS, Hetzner Object Storage, MinIO …)" "Local or mounted directory"
  case $pick in
    1) prompt_r2 ;;
    2) prompt_s3 ;;
    3) REPO_TYPE=posix ;;
  esac
  if [[ $REPO_TYPE == posix ]]; then
    ask REPO_PATH "Repository directory" "${REPO_PATH:-/var/lib/pgbackrest}"
  else
    [[ -n $S3_BUCKET ]] || die "Bucket name is required"
    if [[ -z $REPO_PATH || $REPO_PATH == /var/lib/pgbackrest ]]; then REPO_PATH="/$(hostname -s)"; fi
    ask REPO_PATH "Path prefix inside the bucket" "$REPO_PATH"
  fi
  if [[ $REPO_PATH != /* ]]; then REPO_PATH="/$REPO_PATH"; fi
}

prompt_r2() {
  local detected="" jur jdef=1
  REPO_TYPE=r2
  if [[ -z $R2_ACCOUNT_ID ]]; then detected=$(detect_r2_account || true); fi
  if [[ -n $detected ]]; then info "Found R2 account id $detected in an app .env"; fi
  while :; do
    ask R2_ACCOUNT_ID "Cloudflare account ID" "${R2_ACCOUNT_ID:-$detected}"
    if [[ $R2_ACCOUNT_ID =~ ^[0-9a-f]{32}$ ]]; then break; fi
    warn "Expected a 32-character hex account id"
  done
  case $R2_JURISDICTION in eu) jdef=2 ;; fedramp) jdef=3 ;; esac
  choose jur "Bucket jurisdiction (must match how the bucket was created)" "$jdef" "default" "eu" "fedramp"
  case $jur in
    1) R2_JURISDICTION=default S3_ENDPOINT="$R2_ACCOUNT_ID.r2.cloudflarestorage.com" ;;
    2) R2_JURISDICTION=eu S3_ENDPOINT="$R2_ACCOUNT_ID.eu.r2.cloudflarestorage.com" ;;
    3) R2_JURISDICTION=fedramp S3_ENDPOINT="$R2_ACCOUNT_ID.fedramp.r2.cloudflarestorage.com" ;;
  esac
  S3_REGION=auto
  S3_URI_STYLE=path
  ask S3_BUCKET "Bucket name" "$S3_BUCKET"
  info "Use an R2 API token with \"Object Read & Write\" on this bucket only."
  ask S3_KEY "Access key ID" "$S3_KEY"
  ask_secret S3_SECRET "Secret access key" "$S3_SECRET"
}

prompt_s3() {
  local style
  REPO_TYPE=s3
  ask S3_ENDPOINT "Endpoint host (no https://, e.g. fsn1.your-objectstorage.com)" "$S3_ENDPOINT"
  S3_ENDPOINT=${S3_ENDPOINT#https://}
  S3_ENDPOINT=${S3_ENDPOINT%/}
  ask S3_REGION "Region" "$S3_REGION"
  ask S3_BUCKET "Bucket name" "$S3_BUCKET"
  choose style "URI style" "$([[ $S3_URI_STYLE == host ]] && echo 2 || echo 1)" "path (bucket in path, works everywhere)" "host (virtual-hosted)"
  if [[ $style == 2 ]]; then S3_URI_STYLE=host; else S3_URI_STYLE=path; fi
  ask S3_KEY "Access key ID" "$S3_KEY"
  ask_secret S3_SECRET "Secret access key" "$S3_SECRET"
}

prompt_cipher() {
  local pick
  header "Encryption"
  if [[ -n $CIPHER_PASS ]]; then
    info "Keeping the existing encryption passphrase."
    return 0
  fi
  choose pick "Passphrase" 1 "Generate a new one (new repository)" "Enter an existing one (repository already has backups)"
  if [[ $pick == 2 ]]; then
    ask_secret CIPHER_PASS "Existing passphrase"
    [[ -n $CIPHER_PASS ]] || die "Passphrase is required"
    return 0
  fi
  CIPHER_PASS=$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | head -c 64)
  printf '\n  %s┌──────────────────────────────────────────────────────────────────────────┐%s\n' "$Y" "$N"
  printf '  %s│%s %-73s%s│%s\n' "$Y" "$N" "Encryption passphrase — store it in your password manager NOW." "$Y" "$N"
  printf '  %s│%s %-73s%s│%s\n' "$Y" "$N" "Without it the backups cannot be restored. It is also kept in" "$Y" "$N"
  printf '  %s│%s %-73s%s│%s\n' "$Y" "$N" "$CONF_FILE, which dies with this server." "$Y" "$N"
  printf '  %s└──────────────────────────────────────────────────────────────────────────┘%s\n' "$Y" "$N"
  printf '\n    %s%s%s\n\n' "$B" "$CIPHER_PASS" "$N"
  until confirm "Stored the passphrase safely?" N; do warn "Store it first — it cannot be recovered."; done
}

schedule_time() {
  local m h
  read -r m h _ <<<"${FULL_SCHEDULE:-30 1}"
  if [[ $m =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]]; then
    printf '%02d:%02d' "$((10#$h))" "$((10#$m))"
  else
    printf '01:30'
  fi
}

edit_schedule() {
  local pick t h m
  header "Backup schedule"
  choose pick "Schedule" 1 \
    "Weekly full (Sunday) + daily differential  [recommended]" \
    "Daily full" \
    "Weekly full + daily differential + hourly incremental" \
    "Custom cron expressions"
  if [[ $pick == 4 ]]; then
    edit_custom_schedule
    return 0
  fi
  while :; do
    ask t "Time of day (HH:MM, server time $(date +%Z))" "$(schedule_time)"
    if [[ $t =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then break; fi
    warn "Expected HH:MM"
  done
  h=$((10#${t%%:*}))
  m=$((10#${t##*:}))
  case $pick in
    1) FULL_SCHEDULE="$m $h * * 0" DIFF_SCHEDULE="$m $h * * 1-6" INCR_SCHEDULE="" ;;
    2) FULL_SCHEDULE="$m $h * * *" DIFF_SCHEDULE="" INCR_SCHEDULE="" ;;
    3) FULL_SCHEDULE="$m $h * * 0" DIFF_SCHEDULE="$m $h * * 1-6" INCR_SCHEDULE="$(((m + 30) % 60)) * * * *" ;;
  esac
}

edit_custom_schedule() {
  local expr type var
  for type in full diff incr; do
    var="${type^^}_SCHEDULE"
    while :; do
      ask expr "Cron for $type backups (5 fields, '-' = off)" "${!var:--}"
      if [[ $expr == - ]]; then expr=""; fi
      if [[ -z $expr || $(wc -w <<<"$expr") -eq 5 ]]; then break; fi
      warn "Expected 5 cron fields, e.g. '30 1 * * 0'"
    done
    printf -v "$var" '%s' "$expr"
  done
}

edit_retention() {
  info "Point-in-time recovery stays possible for at least this many days (older backups + WAL expire)."
  ask_int RETENTION_DAYS "Retention in days" "$RETENTION_DAYS" 1 3650
}

edit_rpo() {
  info "archive_timeout forces a WAL switch at least every N seconds = max data loss when the disk dies."
  ask_int ARCHIVE_TIMEOUT "archive_timeout seconds (RPO)" "$ARCHIVE_TIMEOUT" 10 3600
}

edit_performance() {
  ask_int PROCESS_MAX "Parallel backup/restore processes" "$PROCESS_MAX" 1 32
  ask_int COMPRESS_LEVEL "zstd compression level (1 fast … 19 small)" "$COMPRESS_LEVEL" 1 19
}

edit_queue() {
  info "If the repository is unreachable, WAL queues locally up to this size; beyond it WAL is dropped"
  info "(the PITR chain breaks, but the disk does not fill up and PostgreSQL keeps running)."
  ask ARCHIVE_QUEUE_MAX "Max local WAL queue (e.g. 8GB)" "$ARCHIVE_QUEUE_MAX"
}

edit_heartbeat() {
  info "Pinged after every scheduled backup: <url> on success, <url>/fail on failure (healthchecks.io style)."
  ask HEARTBEAT_URL "Heartbeat URL ('-' = off)" "${HEARTBEAT_URL:--}"
  if [[ $HEARTBEAT_URL == - ]]; then HEARTBEAT_URL=""; fi
}

show_status() {
  local load mem_total mem_used
  header "postgres-manager $version · $(hostname -f 2>/dev/null || hostname) · $OS_PRETTY ($(uname -m))"
  load=$(cut -d' ' -f1-3 /proc/loadavg | tr ' ' '/')
  read -r mem_total mem_used < <(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "%.0f %.0f\n", t*1024, (t-a)*1024}' /proc/meminfo)
  row System "load $load · $(nproc) cpu · mem $(hb "$mem_used")/$(hb "$mem_total") · up $(duration "$(cut -d. -f1 /proc/uptime)")"
  row Disk "$(df -hP "$PG_DATA" 2>/dev/null | awk 'NR==2 {print $3"/"$2" used ("$5"), "$4" free on "$6}')"

  if pg_ready; then
    status_postgres
    status_apps
    status_archiving
  else
    row Postgres "$PG_VERSION/$PG_CLUSTER port $PG_PORT · $(bad "not accepting connections ($PG_STATUS)")"
  fi
  status_backups
}

status_postgres() {
  local ver up conns maxc active hit longest walsize slots total conn_txt long_txt dbs db exts ext_line=""
  IFS=$'\t' read -r ver up conns maxc active hit longest walsize slots total < <(psql_q "
    select current_setting('server_version'),
           extract(epoch from now() - pg_postmaster_start_time())::bigint,
           (select count(*) from pg_stat_activity where backend_type = 'client backend'),
           current_setting('max_connections'),
           (select count(*) from pg_stat_activity where backend_type = 'client backend' and state <> 'idle'),
           coalesce((select round(100.0 * sum(blks_hit) / nullif(sum(blks_hit) + sum(blks_read), 0), 2) from pg_stat_database), 0),
           coalesce((select extract(epoch from max(now() - xact_start))::bigint from pg_stat_activity
                     where backend_type = 'client backend' and xact_start is not null), 0),
           (select coalesce(sum(size), 0) from pg_ls_waldir()),
           (select count(*) from pg_replication_slots),
           (select sum(pg_database_size(oid)) from pg_database)")

  conn_txt="$conns/$maxc (active $active)"
  if ((conns * 100 / maxc >= 80)); then conn_txt=$(bad "$conn_txt"); fi
  long_txt="longest txn $(duration "$longest")"
  if ((longest > 300)); then long_txt=$(meh "$long_txt"); fi

  row Postgres "${ver%% *} · cluster $PG_VERSION/$PG_CLUSTER · port $PG_PORT · $(good online) · up $(duration "$up")"
  row "" "connections $conn_txt · cache hit ${hit}% · $long_txt"
  row "" "data $(hb "$total") · WAL $(hb "$walsize") · slots $slots · $(dim "$PG_DATA")"

  dbs=$(psql_q "select datname || ' ' || pg_size_pretty(pg_database_size(oid)) from pg_database
                where not datistemplate order by pg_database_size(oid) desc limit 6" | paste -sd ',' - | sed 's/,/, /g')
  row Databases "$dbs"

  while IFS= read -r db; do
    [[ -n $db ]] || continue
    exts=$(psql_q "select string_agg(extname || ' ' || extversion, ', ' order by extname) from pg_extension where extname <> 'plpgsql'" "$db" 2>/dev/null || true)
    if [[ -n $exts ]]; then ext_line+="${ext_line:+ · }$db: $exts"; fi
  done < <(list_databases | head -n 15)
  row Extensions "${ext_line:-none} · $(dim "preload: $(pg_setting shared_preload_libraries)")"
}

status_apps() {
  local site env database user hostport label=Apps
  while IFS=$'\t' read -r site _ env database user hostport; do
    [[ -n $site ]] || continue
    row "$label" "$(basename "$site") → $database $(dim "(user $user @ $hostport${env:+, $env})")"
    label=""
  done < <(scan_apps)
}

status_archiving() {
  local mode timeout count wal last_ts failed fwal fail_ts queued extra=""
  mode=$(pg_setting archive_mode)
  if [[ $mode != on && $mode != always ]]; then
    row Archiving "$(meh off) · no point-in-time recovery"
    return 0
  fi
  timeout=$(pg_setting archive_timeout)
  IFS=$'\t' read -r count wal last_ts failed fwal fail_ts < <(psql_q "
    select archived_count, coalesce(last_archived_wal, '-'), coalesce(extract(epoch from last_archived_time)::bigint, 0),
           failed_count, coalesce(last_failed_wal, '-'), coalesce(extract(epoch from last_failed_time)::bigint, 0)
    from pg_stat_archiver")
  queued=$(find "$PG_DATA/pg_wal/archive_status" -name '*.ready' 2>/dev/null | wc -l)
  if ((failed)); then extra+=" · $failed failed since reset"; fi
  if ((queued > 2)); then extra+=" · $(meh "$queued WAL queued")"; fi
  if ((fail_ts > last_ts)); then
    row Archiving "$(bad FAILING) since $(fmt_ts "$fail_ts") ($fwal) · last ok: $(if ((last_ts)); then echo "$(ago "$last_ts") ago"; else echo never; fi)"
  elif ((last_ts)); then
    row Archiving "$(good ok) · last $(ago "$last_ts") ago ($wal) · $count archived · timeout ${timeout}s$extra"
  else
    row Archiving "$(meh "on, nothing archived yet") · timeout ${timeout}s"
  fi
}

status_backups() {
  if ((CONFIGURED == 0)); then
    row Backups "$(meh "not configured") · run: postgres-manager setup"
    return 0
  fi
  if ! command -v pgbackrest >/dev/null || ! command -v jq >/dev/null; then
    row Backups "$(bad "pgbackrest/jq missing") · run: postgres-manager setup"
    return 0
  fi
  local json code msg count last_full oldest_stop repo_total running last last_type age_txt
  json=$(pgbr_info_json)
  json=${json:-[]}
  code=$(jq -r '.[0].status.code // 99' <<<"$json" 2>/dev/null || echo 99)
  msg=$(jq -r '.[0].status.message // "repository not reachable"' <<<"$json" 2>/dev/null || echo "repository not reachable")
  count=$(jq -r '.[0].backup // [] | length' <<<"$json" 2>/dev/null || echo 0)
  if [[ $code != 0 ]] || ((count == 0)); then
    row Backups "$(bad "$msg") · $(repo_label)"
    row Schedule "$(schedule_line)"
    return 0
  fi
  IFS=$'\t' read -r last_full oldest_stop repo_total running last last_type < <(jq -r '.[0] | [
      ([.backup[] | select(.type == "full")] | last | .timestamp.stop // 0),
      .backup[0].timestamp.stop,
      ([.backup[].info.repository.delta] | add),
      (.status.lock.backup.held // false),
      (.backup | last | .timestamp.stop),
      (.backup | last | .type)
    ] | @tsv' <<<"$json")
  age_txt="last $last_type $(ago "$last") ago"
  if (($(date +%s) - last > 2 * 86400)); then age_txt=$(bad "$age_txt"); fi
  if [[ $last_type != full ]]; then age_txt+=" · last full $(ago "$last_full") ago"; fi
  if [[ $running == true ]]; then age_txt+=" · $(meh "backup running")"; fi
  row Backups "$(good ok) · $age_txt · $count sets · $(hb "$repo_total") in repo"
  row PITR "from $(fmt_ts "$oldest_stop") ($(ago "$oldest_stop")) until now · retention ${RETENTION_DAYS}d · $(repo_label)"
  row Schedule "$(schedule_line)"
}

require_root() {
  [[ $EUID -eq 0 ]] || die "Run as root: sudo $SELF ${action:-}"
}

detect_os() {
  [[ -r /etc/os-release ]] || die "Unsupported OS (no /etc/os-release)"
  OS_ID=$(. /etc/os-release && echo "${ID:-}")
  OS_LIKE=$(. /etc/os-release && echo "${ID_LIKE:-}")
  OS_CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME:-}")
  OS_PRETTY=$(. /etc/os-release && echo "${PRETTY_NAME:-$ID}")
  if [[ $OS_ID != debian && $OS_ID != ubuntu ]]; then
    case $OS_LIKE in
      *ubuntu*) OS_ID=ubuntu ;;
      *debian*) OS_ID=debian ;;
      *) die "Unsupported OS: $OS_PRETTY (Debian/Ubuntu only)" ;;
    esac
  fi
}

APT_UPDATED=0
apt_update() {
  if ((APT_UPDATED == 0)); then
    info "apt-get update"
    DEBIAN_FRONTEND=noninteractive apt-get update -qq </dev/null
    APT_UPDATED=1
  fi
}

apt_install() {
  local missing=() pkg
  for pkg in "$@"; do
    if ! pkg_installed "$pkg"; then missing+=("$pkg"); fi
  done
  if ((${#missing[@]} == 0)); then return 0; fi
  apt_update
  info "Installing ${missing[*]}"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${missing[@]}" </dev/null >/dev/null 2>&1
}

pkg_installed() {
  [[ $(dpkg-query -W -f='${Status}' "$1" 2>/dev/null || true) == "install ok installed" ]]
}

pkg_available() {
  local cand
  cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
  [[ -n $cand && $cand != "(none)" ]]
}

has_pgdg_repo() {
  grep -rqs 'apt.postgresql.org' /etc/apt/sources.list /etc/apt/sources.list.d/
}

ensure_pgdg_repo() {
  if has_pgdg_repo; then return 0; fi
  warn "The official PostgreSQL apt repository (apt.postgresql.org) is not configured."
  if ! confirm "Add it? (recommended: current pgBackRest and extension packages)" Y; then return 1; fi
  apt_update
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends postgresql-common ca-certificates curl gnupg </dev/null >/dev/null 2>&1
  /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y </dev/null >/dev/null 2>&1
  APT_UPDATED=0
  apt_update
  ok "Added apt.postgresql.org"
}

ensure_timescale_repo() {
  if grep -rqs 'packagecloud.io/timescale' /etc/apt/sources.list /etc/apt/sources.list.d/; then return 0; fi
  apt_install curl gnupg ca-certificates
  install -d -m 0755 /etc/apt/keyrings
  curl -fsSL https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor --yes -o /etc/apt/keyrings/timescaledb.gpg
  echo "deb [signed-by=/etc/apt/keyrings/timescaledb.gpg] https://packagecloud.io/timescale/timescaledb/$OS_ID/ $OS_CODENAME main" \
    >/etc/apt/sources.list.d/timescaledb.list
  APT_UPDATED=0
  apt_update
  ok "Added the TimescaleDB apt repository"
}

postgres_manager_menu_command() {

  show_status
  while :; do
    printf '\n'
    if ((CONFIGURED)); then
      printf '  %s1)%s Backups: list        %s2)%s Run backup now     %s3)%s Edit settings\n' "$B" "$N" "$B" "$N" "$B" "$N"
      printf '  %s4)%s Restore / PITR       %s5)%s Restore drill      %s6)%s Check archiving\n' "$B" "$N" "$B" "$N" "$B" "$N"
      printf '  %s7)%s Extensions           %s8)%s Re-run setup       %s9)%s Refresh status\n' "$B" "$N" "$B" "$N" "$B" "$N"
    else
      printf '  %s1)%s Set up backups (pgBackRest + WAL archiving)\n' "$B" "$N"
      printf '  %s7)%s Extensions    %s9)%s Refresh status\n' "$B" "$N" "$B" "$N"
    fi
    printf '  %sq)%s Quit\n' "$B" "$N"
    printf 'Choose: '
    IFS= read -r choice || break
    if ((CONFIGURED == 0)) && [[ $choice =~ ^([1-6]|8)$ ]]; then choice=8; fi

    cmd=()
    case $choice in
      1) cmd=(list) ;;
      2)
        ask type "Type (full/diff/incr)" diff
        cmd=(backup "$type")
        ;;
      3) cmd=(edit) ;;
      4) cmd=(restore) ;;
      5) cmd=(verify) ;;
      6) cmd=(check) ;;
      7) cmd=(extensions) ;;
      8) cmd=(setup) ;;
      9) cmd=(status) ;;
      q | Q | '') break ;;
      *) warn "Unknown choice" ;;
    esac
    if ((${#cmd[@]})); then
      "$SELF" "${cmd[@]}" || warn "${cmd[0]} ended with exit code $?"
      CONFIGURED=0
      load_config
    fi
  done

}

postgres_manager_status_command() {

  show_status

}

postgres_manager_setup_command() {

  header "Backup setup · PostgreSQL $PG_VERSION/$PG_CLUSTER · $PG_DATA"
  pg_ready || die "PostgreSQL $PG_VERSION/$PG_CLUSTER must be running"
  if ((CONFIGURED)); then
    warn "Backups are already configured ($(repo_label)). Re-running setup keeps unchanged values."
    confirm "Continue?" Y || exit 0
  fi

  header "Packages"
  if ! has_pgdg_repo || ! pkg_available pgbackrest; then ensure_pgdg_repo || true; fi
  apt_install pgbackrest jq curl cron ca-certificates
  pgbackrest_version=$(pgbr_version)
  ok "pgBackRest $pgbackrest_version"
  if ! version_ge "$pgbackrest_version" "$PGBR_MIN_BLOCK_VERSION"; then
    warn "pgBackRest < $PGBR_MIN_BLOCK_VERSION: no block incremental backups (add apt.postgresql.org for a current version)"
  fi

  ask STANZA "Stanza name" "${STANZA:-$PG_CLUSTER}"
  prompt_repository
  prompt_cipher

  header "Schedule & retention"
  row Schedule "$(schedule_line)"
  row Retention "${RETENTION_DAYS} days"
  row RPO "archive_timeout ${ARCHIVE_TIMEOUT}s"
  row Parallel "$PROCESS_MAX processes · zstd level $COMPRESS_LEVEL"
  if ! confirm "Use these settings?" Y; then
    edit_schedule
    edit_retention
    edit_rpo
    edit_performance
  fi
  edit_heartbeat

  save_config
  render_pgbackrest_conf
  ok "Wrote $CONF_FILE and $PGBR_CONF"

  header "Repository"
  info "Testing repository access"
  repo_reachable || die "Cannot access the repository — check endpoint, bucket and keys (postgres-manager edit)"
  ok "Repository reachable"
  pgbr --log-level-console=warn stanza-create
  ok "Stanza $STANZA ready"

  header "WAL archiving"
  write_archive_snippet
  if ((ARCHIVE_NEEDS_RESTART)); then
    warn "archive_mode/wal_level changes need a PostgreSQL restart (a few seconds of downtime)."
    if confirm "Restart PostgreSQL $PG_VERSION/$PG_CLUSTER now?" Y; then
      pg_restart
    else
      warn "Archiving starts after the next restart — then run: postgres-manager check"
    fi
  fi
  if [[ $(pg_setting archive_mode) == on ]]; then
    pgbr --log-level-console=warn check
    ok "WAL archiving works"
  fi

  install_self
  write_cron
  ok "Cron: $(schedule_line)"

  if [[ $(pg_setting archive_mode) == on ]] && confirm "Run the first full backup now?" Y; then
    run_backup full
  fi
  header "Done"
  status_archiving
  status_backups

}

postgres_manager_edit_command() {

  require_configured
  repo_changed=0
  old_archive_timeout=$ARCHIVE_TIMEOUT
  while :; do
    header "Backup settings"
    choose pick "Change" 9 \
      "Schedule            $(schedule_line)" \
      "Retention           ${RETENTION_DAYS} days" \
      "RPO                 archive_timeout ${ARCHIVE_TIMEOUT}s" \
      "Performance         $PROCESS_MAX processes, zstd $COMPRESS_LEVEL" \
      "WAL queue limit     $ARCHIVE_QUEUE_MAX" \
      "Heartbeat URL       ${HEARTBEAT_URL:-off}" \
      "Repository          $(repo_label)" \
      "Show encryption passphrase" \
      "Save & apply"
    case $pick in
      1) edit_schedule ;;
      2) edit_retention ;;
      3) edit_rpo ;;
      4) edit_performance ;;
      5) edit_queue ;;
      6) edit_heartbeat ;;
      7)
        warn "A new repository starts empty: a new full backup is taken after saving."
        prompt_repository
        repo_changed=1
        ;;
      8) printf '\n    %s%s%s\n' "$B" "$CIPHER_PASS" "$N" ;;
      9) break ;;
    esac
  done

  apply_config
  if [[ $ARCHIVE_TIMEOUT != "$old_archive_timeout" ]]; then write_archive_snippet; fi
  ok "Saved and applied"

  if ((repo_changed)); then
    repo_reachable || die "Cannot access the new repository"
    pgbr --log-level-console=warn stanza-create
    pgbr --log-level-console=warn check
    run_backup full
  fi

}

postgres_manager_list_command() {

  require_configured
  json=$(pgbr_info_json)
  [[ -n $json ]] || die "pgbackrest info failed — run: postgres-manager check"
  header "Backups · stanza $STANZA · $(repo_label)"
  if [[ $(jq -r '.[0].status.code' <<<"$json") != 0 ]]; then
    warn "$(jq -r '.[0].status.message' <<<"$json")"
    exit 0
  fi

  printf '  %s%-34s %-5s %-17s %9s %10s %10s%s\n' "$D" LABEL TYPE STARTED DURATION SIZE REPO "$N"
  while IFS=$'\t' read -r label type start stop size delta; do
    printf '  %-34s %-5s %-17s %9s %10s %10s\n' "$label" "$type" "$(fmt_ts "$start")" \
      "$(duration $((stop - start)))" "$(hb "$size")" "$(hb "$delta")"
  done < <(jq -r '.[0].backup[] | [.label, .type, .timestamp.start, .timestamp.stop, .info.size, .info.repository.delta] | @tsv' <<<"$json")

  IFS=$'\t' read -r oldest wal_min wal_max total < <(jq -r '.[0] | [.backup[0].timestamp.stop, (.archive[-1].min // "-"),
    (.archive[-1].max // "-"), ([.backup[].info.repository.delta] | add)] | @tsv' <<<"$json")
  echo
  row PITR "any point from $(fmt_ts "$oldest") until the last archived WAL"
  row WAL "$wal_min … $wal_max"
  row Repo "$(hb "$total") (backups, excl. WAL)"

}

postgres_manager_backup_command() {

  require_configured
  run_backup "${args[type]}"

}

postgres_manager_check_command() {

  require_configured
  pgbr --log-level-console=info check
  ok "Archiving and repository OK"

}

postgres_manager_verify_command() {

  require_configured
  dir="$(dirname "$(dirname "$PG_DATA")")/pgm-verify-$PG_VERSION-$PG_CLUSTER"
  [[ $dir == /*/pgm-verify-* ]] || die "Unexpected verify dir $dir"
  if [[ -e $dir ]]; then
    stop_standalone "$dir"
    rm -rf "$dir"
  fi
  install -d -o postgres -g postgres -m 0700 "$dir"
  disk_check "$dir" "$(latest_backup_size)"

  header "Restore drill → $dir"
  started=$(date +%s)
  restore_into_dir "$dir"
  write_standalone_conf "$dir" "$VERIFY_PORT"
  start_standalone "$dir" "$VERIFY_PORT"
  ok "Restored and recovered in $(ago "$started")"

  header "Comparison"
  printf '  %s%-30s %12s %12s %8s%s\n' "$D" DATABASE LIVE RESTORED TABLES "$N"
  while IFS= read -r db; do
    [[ -n $db ]] || continue
    live=$(psql_q "select pg_database_size('$db')" 2>/dev/null || true)
    restored=$(standalone_psql "$dir" "$VERIFY_PORT" "$db" "select pg_database_size(current_database())" || true)
    tables=$(standalone_psql "$dir" "$VERIFY_PORT" "$db" "select count(*) from pg_class where relkind in ('r', 'p')
      and relnamespace not in ('pg_catalog'::regnamespace, 'information_schema'::regnamespace)" || echo "?")
    printf '  %-30s %12s %12s %8s\n' "$db" "$(hb "$live")" "$(if [[ -n $restored ]]; then hb "$restored"; else bad missing; fi)" "$tables"
  done < <(list_databases)
  echo
  row Recovered "$(recovered_until "$dir/postgres-manager.log")"

  if [[ -n ${args[--keep]-} ]]; then
    ok "Kept running: sudo -u postgres psql -h $dir -p $VERIFY_PORT -d <db>"
    info "Stop + remove: sudo -u postgres $PG_BIN/pg_ctl -D $dir stop && sudo rm -rf $dir"
  else
    stop_standalone "$dir"
    rm -rf "$dir"
    ok "Restore drill passed — temporary copy removed"
  fi

}

postgres_manager_restore_command() {

  require_configured
  time=${args[--time]-}
  set_label=${args[--set]-}
  target_dir=${args[--target-dir]-}
  yes=${args[--yes]-}

  if [[ -z $time && -z $set_label && -z $target_dir ]]; then
    "$SELF" list
    header "Restore"
    choose mode "Recover to" 1 "Latest (end of archived WAL)" "Point in time" "End of a specific backup set"
    case $mode in
      2) ask time "Target time (YYYY-MM-DD HH:MM[:SS], server time $(date +%Z))" ;;
      3) ask set_label "Backup set label" ;;
    esac
    where=""
    choose where "Restore into" 1 "A separate directory (safe — inspect or copy data)" "THIS cluster ($PG_VERSION/$PG_CLUSTER, replaces its data)"
    if [[ $where == 1 ]]; then
      ask target_dir "Directory" "$(dirname "$(dirname "$PG_DATA")")/pgm-restore-$(date +%Y%m%d-%H%M)"
    fi
  fi

  restore_args=()
  if [[ -n $time ]]; then
    target_time=$(date -d "$time" '+%Y-%m-%d %H:%M:%S%:z' 2>/dev/null) || die "Cannot parse time: $time"
    restore_args+=(--type=time "--target=$target_time" --target-action=promote)
    info "Target time: $target_time"
  elif [[ -n $set_label ]]; then
    restore_args+=("--set=$set_label" --type=immediate --target-action=promote)
  fi

  if [[ -n $target_dir ]]; then
    [[ $target_dir == /* ]] || die "Target directory must be absolute"
    install -d -o postgres -g postgres -m 0700 "$target_dir"
    disk_check "$target_dir" "$(latest_backup_size)"
    restore_into_dir "$target_dir" "${restore_args[@]}"
    write_standalone_conf "$target_dir" "$RESTORE_PORT"
    ok "Restored into $target_dir (archiving disabled, config written for a standalone start)"
    if [[ -n $yes ]] || confirm "Start it now on a private socket (port $RESTORE_PORT)?" Y; then
      start_standalone "$target_dir" "$RESTORE_PORT"
      ok "Running: sudo -u postgres psql -h $target_dir -p $RESTORE_PORT -d <db>"
      info "Copy a table: sudo -u postgres pg_dump -h $target_dir -p $RESTORE_PORT -d <db> -t <table> > table.sql"
      info "Stop: sudo -u postgres $PG_BIN/pg_ctl -D $target_dir stop"
    fi
    exit 0
  fi

  header "Restore over the live cluster $PG_VERSION/$PG_CLUSTER"
  warn "This stops PostgreSQL and replaces $PG_DATA with the backup (delta restore)."
  if [[ -z $yes ]]; then
    typed=""
    ask typed "Type '$PG_VERSION/$PG_CLUSTER' to continue"
    [[ $typed == "$PG_VERSION/$PG_CLUSTER" ]] || die "Aborted"
  fi
  backup_lock try || die "A backup is running — wait for it to finish"
  info "Stopping PostgreSQL"
  pg_ctlcluster "$PG_VERSION" "$PG_CLUSTER" stop -m fast || true
  pgbr --delta --log-level-console=info "${restore_args[@]}" restore
  backup_unlock
  info "Starting PostgreSQL (replays WAL — may take a while)"
  pg_ctlcluster "$PG_VERSION" "$PG_CLUSTER" start
  wait_ready 86400
  until [[ $(psql_q "select pg_is_in_recovery()") == f ]]; do sleep 5; done
  ok "Restore finished — cluster is online on a new timeline"
  if [[ -n $yes ]] || confirm "Take a new full backup now (recommended after a point-in-time restore)?" Y; then
    run_backup full
  fi

}

postgres_manager_extensions_command() {

  pg_ready || die "PostgreSQL $PG_VERSION/$PG_CLUSTER is not running"
  preload=$(pg_setting shared_preload_libraries)

  header "Extensions · PostgreSQL $PG_VERSION/$PG_CLUSTER"
  i=1
  for key in "${EXTENSIONS[@]}"; do
    printf '  %s%d)%s %-52s %s\n' "$B" "$i" "$N" "$(ext_label "$key")" "$(ext_state "$key" "$preload")"
    i=$((i + 1))
  done
  ask selection "Install/enable which (e.g. \"1 3\", empty = cancel)" ""
  [[ -n $selection ]] || exit 0
  chosen=()
  for n in $selection; do
    [[ $n =~ ^[1-5]$ ]] || die "Invalid choice: $n"
    chosen+=("${EXTENSIONS[n - 1]}")
  done

  header "Packages"
  for key in "${chosen[@]}"; do ensure_ext_package "$key"; done
  ok "Packages ready"

  new_preload=$preload
  restart=0
  for key in "${chosen[@]}"; do
    if ext_needs_preload "$key" && ! preload_has "$new_preload" "$key"; then
      new_preload="${new_preload:+$new_preload,}$key"
      restart=1
    fi
  done
  default_dbs=$(app_databases)
  cron_db=$(pg_setting cron.database_name)
  if [[ " ${chosen[*]} " == *" pg_cron "* ]]; then
    cron_db_new=""
    ask cron_db_new "Database for pg_cron jobs (cron.database_name)" "${cron_db:-${default_dbs%% *}}"
    if [[ $cron_db_new != "$cron_db" ]]; then restart=1; fi
    cron_db=$cron_db_new
  fi
  if ((restart)); then
    write_pg_snippet "$PG_SNIPPET_EXTENSIONS" "# Managed by postgres-manager — extension settings.
  shared_preload_libraries = '$new_preload'${cron_db:+
  cron.database_name = '$cron_db'}"
    warn "shared_preload_libraries changed ($new_preload) — needs a PostgreSQL restart."
    if confirm "Restart PostgreSQL $PG_VERSION/$PG_CLUSTER now?" Y; then
      pg_restart
    else
      warn "Restart later, then run extensions again to CREATE EXTENSION the preloaded ones."
    fi
  fi

  header "Enable in databases"
  info "Databases: $(list_databases | tr '\n' ' ')"
  ask targets "CREATE EXTENSION in which databases (space-separated, 'all', '-' = skip)" "${default_dbs:--}"
  case $targets in
    -) targets="" ;;
    all) targets=$(list_databases | grep -vx postgres | tr '\n' ' ') ;;
  esac
  preload=$(pg_setting shared_preload_libraries)
  for key in "${chosen[@]}"; do
    sql=$(ext_sql_name "$key")
    if ext_needs_preload "$key" && ! preload_has "$preload" "$key"; then
      warn "$key is not preloaded yet (restart pending) — skipped"
      continue
    fi
    key_targets=$targets
    if [[ $key == pg_cron ]]; then key_targets=$(pg_setting cron.database_name); fi
    for db in $key_targets; do
      if ! database_exists "$db"; then
        warn "Database $db does not exist — skipped"
      elif psql_q "create extension if not exists \"$sql\"" "$db" >/dev/null 2>&1; then
        ok "$sql enabled in $db"
      else
        warn "Could not create $sql in $db"
      fi
    done
  done

}

postgres_manager_self_update_command() {

  tmp=$(mktemp)
  info "Downloading $UPDATE_URL"
  curl -fsSL "$UPDATE_URL" -o "$tmp" || die "Download failed"
  bash -n "$tmp" || die "Downloaded script has syntax errors — not installed"
  new_version=$(bash "$tmp" --version)
  install -m 0755 "$tmp" "$INSTALL_PATH"
  rm -f "$tmp"
  ok "Installed postgres-manager $new_version to $INSTALL_PATH (was $version)"

}

postgres_manager_cron_backup_command() {

  require_configured
  type=${args[type]}
  if [[ $type == incr ]]; then
    if ! backup_lock try; then
      echo "another backup is running, skipping incr"
      exit 0
    fi
  elif ! backup_lock wait; then
    heartbeat /fail
    die "timed out waiting for another backup"
  fi
  if pgbr --type="$type" backup; then
    heartbeat ""
  else
    rc=$?
    heartbeat /fail
    exit "$rc"
  fi

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        postgres_manager_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in

    menu)
      action="menu"
      shift
      postgres_manager_menu_parse_requirements "$@"
      shift $#
      ;;

    status)
      action="status"
      shift
      postgres_manager_status_parse_requirements "$@"
      shift $#
      ;;

    setup)
      action="setup"
      shift
      postgres_manager_setup_parse_requirements "$@"
      shift $#
      ;;

    edit)
      action="edit"
      shift
      postgres_manager_edit_parse_requirements "$@"
      shift $#
      ;;

    list | ls)
      action="list"
      shift
      postgres_manager_list_parse_requirements "$@"
      shift $#
      ;;

    backup)
      action="backup"
      shift
      postgres_manager_backup_parse_requirements "$@"
      shift $#
      ;;

    check)
      action="check"
      shift
      postgres_manager_check_parse_requirements "$@"
      shift $#
      ;;

    verify)
      action="verify"
      shift
      postgres_manager_verify_parse_requirements "$@"
      shift $#
      ;;

    restore)
      action="restore"
      shift
      postgres_manager_restore_parse_requirements "$@"
      shift $#
      ;;

    extensions | ext)
      action="extensions"
      shift
      postgres_manager_extensions_parse_requirements "$@"
      shift $#
      ;;

    self-update)
      action="self-update"
      shift
      postgres_manager_self_update_parse_requirements "$@"
      shift $#
      ;;

    cron-backup)
